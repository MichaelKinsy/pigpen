     "type": "integer",
     "minimum": 1
    },
    "scan_id": {
     "type": "string"
    },
    "finding_id": {
     "type": "string"
    },
    "validation_status": {
     "enum": [
      "unvalidated",
      "validated",
      "rejected",
      "partial",
      "error"
     ],
     "type": "string"
    },
    "validation_summary": {
     "type": "string"
    },
    "validation_evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "label": {
        "type": "string",
        "minLength": 1
       },
       "explanation": {
        "type": "string"
       }
      },
      "required": [
       "label",
       "explanation"
      ],
      "additionalProperties": false
     }
    },
    "cloud_configuration_id": {
     "type": "string"
    },
    "repository_id": {
     "type": "string"
    },
    "repository_url": {
     "type": "string"
    },
    "environment_id": {
     "type": "string"
    },
