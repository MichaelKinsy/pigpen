  {
    "tool": "*",
    "match_kind": "agent_loop_error",
    "path": "isError,error",
    "side": "omp-only",
    "class": "HOST",
    "ref_file": "PiG agent/tool_execution.go",
    "ref_term": [
      "errorToolResult is upstream createErrorToolResult",
      "empty details object",
      "no isError"
    ],
    "ref_subject": [
      "errorToolResult",
      "isError"
    ],
    "why": "Matches ONLY omp's prepare-phase agent-loop failure shape (details={isError: true, error: <omp result text>}, agent-loop.ts:3643-3650) vs PiG errorToolResult ({}, agent/tool_execution.go:323-327) with both isError=true; never swallows tool-emitted error/isError fields."
  },
