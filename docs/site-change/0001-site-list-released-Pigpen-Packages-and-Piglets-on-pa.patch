index 0000000..163aa66
--- /dev/null
+++ b/scripts/build-pigpen-catalog.mjs
@@ -0,0 +1,138 @@
+// Adds the Pigpen repository's released Packages and Piglets to /packages. Runs in `pnpm generate` after
+// build-npm-catalog.mjs, so every build (including the daily deploy) refreshes it.
+//
+// Source: Pigpen's generated index.json (raw HTTPS, catalog.config.json names the repository and ref). The index lists a
+// Package as `available` once its release tag is recorded, and a Piglet as `available` once a signed release receipt
+// verified against Pigpen's pinned key is committed (Pigpen's scripts/receipts.mjs does that verification, not this
+// site). This script trusts neither blindly: it validates the index against the schema Pigpen publishes
+// (data/pigpen-index.schema.json), then re-derives every command and URL from the entry's own identity and refuses the
+// entry when they differ, so a hand-edited index cannot put another command on a card. Planned entries are not listed.
+// A fetch that fails or does not validate keeps the committed snapshot (data/pigpen-index.snapshot.json), never a
+// partial list. Outputs (ignored, regenerated): public/catalog/pigpen-package.json, pigpen-piglet.json, and the two
+// sources added to data/npm-catalog.meta.json.
+//
+//   node scripts/build-pigpen-catalog.mjs                    build
+//   node scripts/build-pigpen-catalog.mjs --write-snapshot   also refresh the committed snapshot (review the diff)
+//
+// Environment: PIGPEN_OFFLINE=1 uses the snapshot without a request; PIGPEN_INDEX_FILE=<file> reads that index instead.
+import Ajv from 'ajv';
+import addFormats from 'ajv-formats';
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export const SOURCES = { 'pigpen-package': 'package', 'pigpen-piglet': 'piglet' };
+export const MAX_BYTES = 2 * 1024 * 1024;
+const root = fileURLToPath(new URL('../', import.meta.url));
+const path = (file) => resolve(root, file);
+const NAME = '[a-z0-9][a-z0-9.-]*';
+const VERSION = '\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?';
+const escape = (text) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+const ajv = new Ajv({ allErrors: true, strictRequired: false });
+addFormats(ajv);
+const validate = ajv.compile(JSON.parse(readFileSync(path('data/pigpen-index.schema.json'), 'utf8')));
+
+/** The raw index URL for the configured repository and ref. */
+export function indexUrl(config) {
+  return `https://raw.githubusercontent.com/${config.repository}/${config.ref}/index.json`;
+}
+
+/** Validate one index and keep only what it may show. Throws on anything the schema or the re-derivation refuses. */
+export function parseIndex(text, config) {
+  if (Buffer.byteLength(text) > MAX_BYTES) throw new Error('Pigpen index is larger than 2 MiB');
+  const index = JSON.parse(text);
+  if (!validate(index)) throw new Error('Pigpen index: ' + ajv.errorsText(validate.errors));
+  const { repository } = config;
+  const owner = repository.split('/')[0];
+  const ids = new Set();
+  const out = { 'pigpen-package': [], 'pigpen-piglet': [], planned: 0 };
+  for (const entry of index.entries) {
+    if (ids.has(entry.id)) throw new Error(`Pigpen index: duplicate id ${entry.id}`);
+    ids.add(entry.id);
+    if (entry.repository !== `https://github.com/${repository}`) throw new Error(`Pigpen index: ${entry.id} is not from ${repository}`);
+    if (entry.maintainer !== owner) throw new Error(`Pigpen index: ${entry.id} has maintainer ${entry.maintainer}, not ${owner}`);
+    if (entry.status === 'planned') { out.planned += 1; continue; }
+    if (entry.kind === 'package') {
+      const spec = new RegExp(`^git:https://github\\.com/${escape(repository)}\\.git@components/(${NAME})/v(${VERSION})#subdirectory=components%2F\\1$`).exec(entry.source.spec);
+      if (!spec || spec[2] !== entry.version) throw new Error(`Pigpen index: ${entry.id} has an unexpected source ${entry.source.spec}`);
+      if (entry.installCommand !== `pig install '${entry.source.spec}'`) throw new Error(`Pigpen index: ${entry.id} has an unexpected install command`);
+      out['pigpen-package'].push({ ...base(entry, index), version: entry.version, command: entry.installCommand, types: entry.resources, sourceUrl: entry.source.url });
+    } else {
+      const [newest] = entry.releases;
+      for (const release of entry.releases) {
+        const tag = encodeURIComponent(`${entry.name}/v${release.version}`);
+        if (release.pullCommand !== `pig piglet pull 'github:${repository}/${entry.name}@${release.version}'`) throw new Error(`Pigpen index: ${entry.id} ${release.version} has an unexpected pull command`);
+        if (release.indexUrl !== `https://github.com/${repository}/releases/download/${tag}/piglet-release.json`) throw new Error(`Pigpen index: ${entry.id} ${release.version} has an unexpected release URL`);
+        if (!release.verificationKey.publicKeyUrl.startsWith(`https://raw.githubusercontent.com/${repository}/`)) throw new Error(`Pigpen index: ${entry.id} has a verification key outside ${repository}`);
+      }
+      out['pigpen-piglet'].push({ ...base(entry, index), version: newest.version, command: newest.pullCommand, types: [], platforms: newest.platforms, keyId: newest.verificationKey.id, keyUrl: newest.verificationKey.publicKeyUrl, sourceUrl: entry.source.url });
+    }
+  }
+  for (const source of Object.keys(SOURCES)) out[source].sort((a, b) => a.name.localeCompare(b.name, 'en'));
+  return out;
+}
+
+const base = (entry, index) => ({ name: entry.name, description: entry.description, author: entry.maintainer, date: new Date(index.updatedAt + 'T00:00:00Z').toISOString(), downloads: 0, repository: entry.repository });
+
+const sourceMeta = (entries, origin, syncedAt) => ({ syncedAt, origin, count: entries.length, first: entries.slice(0, 24) });
+
+/** Fetch the index: raw HTTPS, one request, no redirects, no credentials, 10 s, 2 MiB. */
+export async function fetchIndex(url, { fetchImpl = fetch } = {}) {
+  const response = await fetchImpl(url, { redirect: 'error', credentials: 'omit', headers: { accept: 'application/json', 'user-agent': 'pi-in-go.dev-build' }, signal: AbortSignal.timeout(10000) });
+  if (!response.ok) throw new Error(`${url}: HTTP ${response.status}`);
+  const length = Number(response.headers.get('content-length') ?? 0);
+  if (length > MAX_BYTES) throw new Error(`${url}: larger than 2 MiB`);
+  const text = await response.text();
+  if (Buffer.byteLength(text) > MAX_BYTES) throw new Error(`${url}: larger than 2 MiB`);
+  return text;
+}
+
+/** {parsed, origin, syncedAt, text, warnings}: the live index when it validates, else the snapshot. */
+export async function loadIndex({ config, snapshotText, offline = false, file, fetchImpl, now = new Date() }) {
+  const warnings = [];
+  if (file) return { parsed: parseIndex(readFileSync(file, 'utf8'), config), origin: 'live', syncedAt: now.toISOString(), text: readFileSync(file, 'utf8'), warnings };
+  if (!offline) {
+    try {
+      const text = await fetchIndex(indexUrl(config), { fetchImpl });
+      return { parsed: parseIndex(text, config), origin: 'live', syncedAt: now.toISOString(), text, warnings };
+    } catch (error) {
+      warnings.push(`Pigpen index not used (${error.message}); keeping the snapshot`);
+    }
+  } else warnings.push('offline mode; using the snapshot');
+  if (!snapshotText) throw new Error('Pigpen index unavailable and there is no snapshot');
+  const snapshot = JSON.parse(snapshotText);
+  return { parsed: parseIndex(JSON.stringify(snapshot.index), config), origin: 'snapshot', syncedAt: snapshot.syncedAt, text: undefined, warnings };
+}
+
+function writeAtomic(file, text) {
+  mkdirSync(dirname(file), { recursive: true });
+  writeFileSync(file + '.tmp', text);
+  renameSync(file + '.tmp', file);
+}
+
+async function main() {
+  const config = JSON.parse(readFileSync(path('catalog.config.json'), 'utf8'));
+  const snapshotFile = path('data/pigpen-index.snapshot.json');
+  const result = await loadIndex({
+    config, snapshotText: existsSync(snapshotFile) ? readFileSync(snapshotFile, 'utf8') : undefined,
+    offline: process.env.PIGPEN_OFFLINE === '1', file: process.env.PIGPEN_INDEX_FILE,
+  });
+  for (const warning of result.warnings) console.warn(`pigpen-catalog: ${warning}`);
+  const metaFile = path('data/npm-catalog.meta.json');
+  if (!existsSync(metaFile)) throw new Error('Run scripts/build-npm-catalog.mjs first: data/npm-catalog.meta.json is missing');
+  const meta = JSON.parse(readFileSync(metaFile, 'utf8'));
+  for (const source of Object.keys(SOURCES)) {
+    const entries = result.parsed[source];
+    writeAtomic(path(`public/catalog/${source}.json`), JSON.stringify({ source, syncedAt: result.syncedAt, origin: result.origin, entries }));
+    meta.sources[source] = sourceMeta(entries, result.origin, result.syncedAt);
+  }
+  writeAtomic(metaFile, JSON.stringify(meta) + '\n');
+  if (process.argv.includes('--write-snapshot')) {
+    if (result.origin !== 'live') throw new Error('refusing to write a snapshot from snapshot data');
+    writeAtomic(snapshotFile, JSON.stringify({ schemaVersion: 1, syncedAt: result.syncedAt, index: JSON.parse(result.text) }, null, 2) + '\n');
+  }
+  console.log(`pigpen-catalog: packages ${result.parsed['pigpen-package'].length}, piglets ${result.parsed['pigpen-piglet'].length}, planned ${result.parsed.planned} not listed (${result.origin})`);
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await main();
diff --git a/test/pigpen-catalog.test.mjs b/test/pigpen-catalog.test.mjs
