{
  "name": "mixed-questions",
  "description": "Single, multi and single again: all answered; the envelope lists each in order.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "ask_user_question",
          "arguments": {
            "questions": [
              {
                "question": "Which database?",
                "header": "Database",
                "options": [
                  {
                    "label": "Postgres",
                    "description": "Relational"
                  },
                  {
                    "label": "SQLite",
                    "description": "Embedded"
                  },
                  {
                    "label": "Redis",
                    "description": "In memory"
                  }
                ]
              },
              {
                "question": "Which features?",
                "header": "Features",
                "options": [
                  {
                    "label": "Auth",
                    "description": "A choice"
                  },
                  {
                    "label": "Cache",
                    "description": "A choice"
                  }
                ],
                "multiSelect": true
              },
              {
                "question": "Which region?",
                "header": "",
                "options": [
                  {
                    "label": "eu",
                    "description": "A choice"
                  },
                  {
                    "label": "us",
                    "description": "A choice"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "decide for me"
      },
      "ui": [
        {
          "value": "1. Postgres \u2014 Relational"
        },
        {
          "value": "1,2"
        },
        {
          "value": "2. us \u2014 A choice"
        }
      ]
    }
  ]
}
