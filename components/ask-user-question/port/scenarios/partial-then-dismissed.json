                "question": "Which database?",
                "header": "Database",
                "options": [
                  {
                    "label": "Postgres",
                    "description": "Relational"
                  },
                  {
                    "label": "SQLite",
                    "description": "Embedded"
                  },
                  {
                    "label": "Redis",
                    "description": "In memory"
                  }
                ]
              },
              {
                "question": "Which region?",
                "header": "Region",
                "options": [
                  {
                    "label": "eu",
