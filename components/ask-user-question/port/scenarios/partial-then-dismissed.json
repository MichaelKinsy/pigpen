                  {
                    "label": "us",
                    "description": "A choice"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "decide for me"
