{
  "name": "config-quiet-hide",
  "description": "quietStartup and hideStatus in the config file keep the notice and the indicator away; the ruleset stays.",
  "llm": [
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "hello",
      "rpc": {
        "type": "prompt",
        "message": "hello"
      }
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p \"$HOME/.config/ponytail\" && printf '%s' '{\"quietStartup\": true, \"hideStatus\": true}' > \"$HOME/.config/ponytail/config.json\""
    ]
  ]
}
