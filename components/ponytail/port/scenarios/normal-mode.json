{
  "name": "normal-mode",
  "description": "'normal mode' as a whole message turns the ruleset off; a sentence containing it does not.",
  "llm": [
    {
      "text": "done"
    },
    {
      "text": "done"
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "mention",
      "rpc": {
        "type": "prompt",
        "message": "add a normal mode toggle next to dark mode"
      }
    },
    {
      "name": "off",
      "rpc": {
        "type": "prompt",
        "message": "normal mode"
      }
    },
    {
      "name": "after",
      "rpc": {
        "type": "prompt",
        "message": "hello"
      }
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p \"$HOME/.config/ponytail\" && printf '%s' '{\"hideStatus\": true}' > \"$HOME/.config/ponytail/config.json\""
    ]
  ]
}
