{
  "name": "command-invalid",
  "description": "An unknown level, and review as a default, are refused.",
  "llm": [],
  "steps": [
    {
      "name": "bogus",
      "rpc": {
        "type": "prompt",
        "message": "/ponytail bogus"
      }
    },
    {
      "name": "review",
      "rpc": {
        "type": "prompt",
        "message": "/ponytail review"
      }
    },
    {
      "name": "default-review",
      "rpc": {
        "type": "prompt",
        "message": "/ponytail default review"
      }
    },
    {
      "name": "default-bare",
      "rpc": {
        "type": "prompt",
        "message": "/ponytail default"
      }
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p \"$HOME/.config/ponytail\" && printf '%s' '{\"hideStatus\": true}' > \"$HOME/.config/ponytail/config.json\""
    ]
  ]
}
