 "extensions": [
  {
   "name": "rewrite.ts",
   "source": "import * as fs from \"node:fs\";\nexport default function (pi: any) {\n  pi.registerCommand(\"eq-rewrite\", {\n    description: \"harness: replace the content of a message entry of the current session file\",\n    handler: async (args: string, ctx: any) => {\n      const [id, ...rest] = args.trim().split(/\\s+/);\n      const file = ctx.sessionManager.getSessionFile();\n      const lines = fs.readFileSync(file, \"utf8\").split(\"\\n\").map((line: string) => {\n        if (line === \"\") return line;\n        const entry = JSON.parse(line);\n        return JSON.stringify(entry.id === id ? { ...entry, message: { ...entry.message, content: rest.join(\" \") } } : entry);\n      });\n      fs.writeFileSync(file, lines.join(\"\\n\"));\n    },\n  });\n}\n",
   "position": "before"
  }
 ],
