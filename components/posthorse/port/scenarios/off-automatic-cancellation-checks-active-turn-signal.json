{
 "name": "off-automatic-cancellation-checks-active-turn-signal",
 "description": "official-host.ts:2198 'automatic cancellation checks the active turn signal before its sentinel'. A helper hook before posthorse aborts the active turn (ctx.abort) inside session_before_compact of an overflow recovery: posthorse commits no boundary and no sentinel, and the retry never runs (1 request). The 'compaction' signal variant (session.abortCompaction) has no RPC equivalent and is covered by a layer-1 Go test.",
 "systemDiff": "hunks",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 100000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": true,
   "reserveTokens": 16384,
   "keepRecentTokens": 1
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {},
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "extensions": [
  {
   "name": "abort-hook.ts",
   "source": "export default function (pi) {\n  pi.on(\"session_before_compact\", (_event, ctx) => { ctx.abort(); });\n}\n",
   "position": "before"
  }
 ],
 "llm": [
  {
   "error": {
    "message": "prompt is too long: 300000 tokens > 100000 maximum"
   }
  },
  {
   "text": "MUST_NOT_RUN"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "Keep the original."
   },
   "settleMs": 800
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
