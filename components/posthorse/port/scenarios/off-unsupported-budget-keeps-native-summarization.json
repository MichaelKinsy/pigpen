{
 "name": "off-unsupported-budget-keeps-native-summarization",
 "description": "official-host.ts:2379 'unsupported automatic budget deliberately keeps native model summarization'. Window 20,000 with reserve 16,384 leaves too few usable tokens: posthorse steps aside, a truncated answer is recovered by the host's own summarization (a model request, fromHook false) and no posthorse boundary exists.",
 "systemDiff": "inserted",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 20000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": true,
   "reserveTokens": 16384,
   "keepRecentTokens": 1
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {},
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "llm": [
  {
   "text": "Partial.",
   "finishReason": "length"
  },
  {
   "text": "NATIVE_UNSUPPORTED_SUMMARY"
  },
  {
   "text": "Recovered."
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "Keep native fallback for this small budget."
   },
   "settleMs": 1500
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
