{
 "name": "off-queued-input-after-automatic-rollover",
 "description": "official-host.ts:1582 'queued input arrives unchanged after native automatic rollover'. Window 32,000 / reserve 1,000. A steer message (80,000 chars) is queued while the first model answer is held (the test queues it from inside the tool; here a trigger sends it before the answer is released, so it is pending when the tool batch ends); the 150,000-char tool result crosses the rollover line and posthorse commits the threshold boundary (record < 20,000 chars) while the queued text reaches the next request unchanged.",
 "systemDiff": "hunks",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 32000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": true,
   "reserveTokens": 1000,
   "keepRecentTokens": 20000
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {},
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end",
  "queue_update"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "extensions": [
  {
   "name": "qd.ts",
   "source": "export default function (pi) {\n  pi.registerTool({\n    name: \"queue_dump\", label: \"Queue dump\", description: \"Queue input and emit output\",\n    parameters: { type: \"object\", properties: {} },\n    async execute() { return { content: [{ type: \"text\", text: \"d\".repeat(150000) }], details: {} }; },\n  });\n}\n",
   "position": "before"
  }
 ],
 "llm": [
  {
   "toolCalls": [
    {
     "name": "queue_dump",
     "arguments": {}
    }
   ],
   "hold": "q",
   "usage": {
    "input": 3500,
    "output": 40
   }
  },
  {
   "text": "Done.",
   "usage": {
    "input": 5000,
    "output": 40
   }
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "ORIGINAL_OWNER {{repeat:a:12000}}"
   },
   "triggers": [
    {
     "when": {
      "llmRequest": 1
     },
     "rpc": {
      "type": "steer",
      "message": "QUEUED_OWNER_INPUT {{repeat:q:80000}}"
     },
     "release": [
      "q"
     ]
    }
   ]
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
