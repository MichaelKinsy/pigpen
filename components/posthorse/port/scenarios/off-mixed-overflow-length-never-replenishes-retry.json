{
 "name": "off-mixed-overflow-length-never-replenishes-retry",
 "description": "official-host.ts:2146 'eligible mixed overflow/length recovery (keepRecentTokens=1) never replenishes the retry allowance'. overflow (recovered), a response truncated inside a new_context call (never executed: the tool result is an error and the handoff TRUNCATED_CALL never enters a record), then a second overflow is final (3 requests, the 4th turn unused).",
 "systemDiff": "hunks",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 100000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": true,
   "reserveTokens": 16384,
   "keepRecentTokens": 1
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {},
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "llm": [
  {
   "error": {
    "message": "prompt is too long: 300000 tokens > 100000 maximum"
   }
  },
  {
   "toolCalls": [
    {
     "name": "new_context",
     "arguments": {
      "handoff": "TRUNCATED_CALL"
     }
    }
   ],
   "finishReason": "length"
  },
  {
   "error": {
    "message": "prompt is too long: 300000 tokens > 100000 maximum"
   }
  },
  {
   "text": "MUST_NOT_RUN"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "Keep the original owner input."
   },
   "settleMs": 1500
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
