   "source": "export default function (pi) {\n  pi.registerCommand(\"eq-bg\", {\n    description: \"Deliver a background completion that starts a turn\",\n    handler: async () => {\n      pi.sendMessage({ customType: \"background-completion\", content: \"NEW_CUSTOM_AFTER_PREFLIGHT: background work completed.\", display: true }, { triggerTurn: true });\n    },\n  });\n}\n",
   "position": "before"
  }
 ],
