{
 "name": "off-incomplete-projected-tool-group-omitted-result",
 "description": "official-host.ts:1171 'automatic retention drops an incomplete projected tool group (omitted result)'. A resumed session whose tool result is omitted by a context_edit (keepRecentTokens=1): the orphan half is never retained; the native preflight record does not carry the orphan receipt at all.",
 "systemDiff": "hunks",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 100000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": true,
   "reserveTokens": 16384,
   "keepRecentTokens": 1
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {
  "files": {
   "seed.jsonl": "{\"type\": \"session\", \"version\": 3, \"id\": \"00000000-0000-4000-8000-000000000001\", \"timestamp\": \"2026-01-01T00:00:00.000Z\", \"cwd\": \"{{cwd}}\"}\n{\"type\": \"message\", \"id\": \"5eed0001\", \"parentId\": null, \"timestamp\": \"2026-01-01T00:00:01.000Z\", \"message\": {\"role\": \"user\", \"content\": \"{{repeat:o:400000}}\", \"timestamp\": 1767225601000}}\n{\"type\": \"message\", \"id\": \"5eed0002\", \"parentId\": \"5eed0001\", \"timestamp\": \"2026-01-01T00:00:02.000Z\", \"message\": {\"role\": \"user\", \"content\": \"LATER_OWNER_INPUT\", \"timestamp\": 1767225602000}}\n{\"type\": \"message\", \"id\": \"5eed0003\", \"parentId\": \"5eed0002\", \"timestamp\": \"2026-01-01T00:00:03.000Z\", \"message\": {\"role\": \"assistant\", \"content\": [{\"type\": \"toolCall\", \"id\": \"omitted-call\", \"name\": \"read\", \"arguments\": {}}], \"api\": \"openai-completions\", \"provider\": \"eq-llm\", \"model\": \"official-posthorse\", \"usage\": {\"input\": 0, \"output\": 0, \"cacheRead\": 0, \"cacheWrite\": 0, \"totalTokens\": 0, \"cost\": {\"input\": 0, \"output\": 0, \"cacheRead\": 0, \"cacheWrite\": 0, \"total\": 0}}, \"stopReason\": \"toolUse\", \"timestamp\": 1767225603000}}\n{\"type\": \"message\", \"id\": \"5eed0004\", \"parentId\": \"5eed0003\", \"timestamp\": \"2026-01-01T00:00:04.000Z\", \"message\": {\"role\": \"toolResult\", \"toolCallId\": \"omitted-call\", \"toolName\": \"read\", \"content\": [{\"type\": \"text\", \"text\": \"LEGACY_ORPHAN_RECEIPT\"}], \"isError\": false, \"timestamp\": 1767225604000}}\n{\"type\": \"context_edit\", \"id\": \"5eed0005\", \"parentId\": \"5eed0004\", \"timestamp\": \"2026-01-01T00:00:05.000Z\", \"targetId\": \"5eed0004\", \"replacement\": null}\n"
  }
 },
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "llm": [
  {
   "text": "Done."
  }
 ],
 "steps": [
  {
   "name": "resume",
   "rpc": {
    "type": "switch_session",
    "sessionPath": "{{sessions}}/seed.jsonl"
   }
  },
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "Continue."
   },
   "settleMs": 150
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
