{
 "name": "off-automatic-handoff-preserves-projected-edits-history-windows",
 "description": "official-host.ts:1425 'automatic handoff preserves projected edits and marks compactions as history windows'. A resumed session with an owner input replaced by a context_edit; a 600k-char dump triggers the threshold rollover: the record carries APPROVED_REPLACEMENT, never PRIVATE_ORIGINAL; a history read of the boundary entry (id saved from get_entries while the model's request is held) shows '[window <id>] [<id>]'.",
 "systemDiff": "hunks",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 100000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": true,
   "reserveTokens": 16384,
   "keepRecentTokens": 20000
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {
  "files": {
   "seed.jsonl": "{\"type\": \"session\", \"version\": 3, \"id\": \"00000000-0000-4000-8000-000000000001\", \"timestamp\": \"2026-01-01T00:00:00.000Z\", \"cwd\": \"{{cwd}}\"}\n{\"type\": \"message\", \"id\": \"5eed0001\", \"parentId\": null, \"timestamp\": \"2026-01-01T00:00:01.000Z\", \"message\": {\"role\": \"user\", \"content\": \"PRIVATE_ORIGINAL\", \"timestamp\": 1767225601000}}\n{\"type\": \"context_edit\", \"id\": \"5eed0002\", \"parentId\": \"5eed0001\", \"timestamp\": \"2026-01-01T00:00:02.000Z\", \"targetId\": \"5eed0001\", \"replacement\": {\"content\": \"APPROVED_REPLACEMENT\"}}\n"
  }
 },
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "extensions": [
  {
   "name": "dump.ts",
   "source": "export default function (pi) {\n  let dumps = 0;\n  pi.registerTool({\n    name: \"dump\", label: \"Dump\", description: \"Oversized local output\",\n    parameters: { type: \"object\", properties: {} },\n    async execute() {\n      const sizes = [600000];\n      const chars = sizes[Math.min(dumps++, sizes.length - 1)];\n      return { content: [{ type: \"text\", text: `DUMP_HEAD ${\"x\".repeat(chars)} DUMP_TAIL` }, ...[]], details: {}, terminate: false };\n    },\n  });\n}\n",
   "position": "before"
  }
 ],
 "llm": [
  {
   "toolCalls": [
    {
     "name": "dump",
     "arguments": {}
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "history",
     "arguments": {
      "op": "read",
      "id": "{{var:boundary}}"
     }
    }
   ],
   "hold": "b"
  },
  {
   "text": "Done."
  }
 ],
 "steps": [
  {
   "name": "resume",
   "rpc": {
    "type": "switch_session",
    "sessionPath": "{{sessions}}/seed.jsonl"
   }
  },
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "Inspect only."
   },
   "triggers": [
    {
     "when": {
      "llmRequest": 2
     },
     "rpc": {
      "type": "get_entries"
     },
     "quiet": true,
     "save": {
      "boundary": "data.entries.[type=compaction].id"
     },
     "release": [
      "b"
     ]
    }
   ]
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
