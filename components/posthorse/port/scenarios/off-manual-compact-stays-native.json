{
 "name": "off-manual-compact-stays-native",
 "description": "official-host.ts:1646 'manual compact remains native and calls the summarization provider'. Compaction disabled, keepRecentTokens 1: two ordinary turns, then the compact command: posthorse leaves it to the host (no posthorse boundary), which summarizes through the model (two summarization requests: history and the retained turn prefix). The command's response (host token estimates) is kept out of the trace; the session file shows the native compaction entry.",
 "systemDiff": "inserted",
 "collapseRuns": 512,
 "model": {
  "id": "official-posthorse",
  "contextWindow": 100000,
  "maxTokens": 1000
 },
 "settings": {
  "compaction": {
   "enabled": false,
   "reserveTokens": 16384,
   "keepRecentTokens": 1
  },
  "retry": {
   "enabled": false
  }
 },
 "session": {},
 "normalize": [
  {
   "pattern": "^[0-9a-f]{8}$",
   "replacement": "<entry-id>"
  },
  {
   "pattern": "\"id\":\"[0-9a-f]{8}\"",
   "replacement": "\"id\":\"<entry-id>\""
  },
  {
   "pattern": "\\b(entry|entries|id|window|through|and) [0-9a-f]{8}\\b",
   "replacement": "$1 <entry-id>"
  },
  {
   "pattern": "\\bid \"[0-9a-f]{8}\"",
   "replacement": "id \"<entry-id>\""
  },
  {
   "pattern": "(use history read\\): |, )[0-9a-f]{8}\\b",
   "replacement": "$1<entry-id>"
  },
  {
   "pattern": "\\[[0-9a-f]{8}\\]",
   "replacement": "[<entry-id>]"
  }
 ],
 "capture": [
  "response",
  "extension_ui_request",
  "extension_error",
  "agent_start",
  "agent_end",
  "turn_start",
  "turn_end",
  "tool_execution_start",
  "tool_execution_end",
  "message_end",
  "compaction_start",
  "compaction_end",
  "auto_retry_start",
  "auto_retry_end"
 ],
 "project": {
  "messageFields": [
   "errorMessage",
   "summary"
  ],
  "drop": [
   "**.estimatedTokensAfter",
   "**.tokensBefore"
  ]
 },
 "llm": [
  {
   "text": "An ordinary response."
  },
  {
   "text": "Another response."
  },
  {
   "text": "NATIVE_MODEL_SUMMARY"
  },
  {
   "text": "NATIVE_PREFIX_SUMMARY"
  }
 ],
 "steps": [
  {
   "name": "one",
   "rpc": {
    "type": "prompt",
    "message": "Ordinary conversation."
   }
  },
  {
   "name": "two",
   "rpc": {
    "type": "prompt",
    "message": "More conversation."
   }
  },
  {
   "name": "compact",
   "rpc": {
    "type": "compact"
   },
   "quiet": true
  }
 ],
 "captureFiles": [
  {
   "root": "sessions",
   "glob": "**/*.jsonl",
   "drop": [
    "**.sections.docs",
    "**.sections.preamble",
    "**.tokensBefore"
   ]
  }
 ]
}
