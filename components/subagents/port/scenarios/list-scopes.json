{
  "name": "list-scopes",
  "description": "List with each agentScope; an invalid scope is refused.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "subagents_enable",
          "arguments": {}
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "list",
            "agentScope": "project"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "list",
            "agentScope": "user"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "list",
            "agentScope": "nowhere"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "delegate the work"
      }
    }
  ],
