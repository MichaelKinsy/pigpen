{
  "name": "schedule-validation",
  "description": "The schedule actions refuse malformed triggers and ids with the original's text.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "subagents_enable",
          "arguments": {}
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "schedule.create",
            "at": "soon",
            "workflowScript": "return 1;"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "schedule.create",
            "at": "+0m",
            "workflowScript": "return 1;"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "schedule.create",
            "every": "5x",
            "workflowScript": "return 1;"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "schedule.pause",
            "id": "bad id!"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "schedule.run"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "subagent",
          "arguments": {
            "action": "schedule.delete"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "delegate the work"
      }
    }
  ],
  "files": {},
  "commands": {
    "git": {
      "mode": "canned",
      "stdout": "",
      "stderr": "",
      "exit": 1
    },
    "npm": {
      "mode": "canned",
      "stdout": "",
      "stderr": "",
      "exit": 1
    },
    "ps": {
      "mode": "canned",
      "stdout": "",
      "stderr": "",
      "exit": 1
    },
    "gh": {
      "mode": "canned",
      "stdout": "",
      "stderr": "",
      "exit": 1
    },
    "powershell.exe": {
      "mode": "canned",
      "stdout": "",
      "stderr": "",
      "exit": 1
    }
  }
}
