{
  "name": "draft-sisyphus",
  "description": "/sisyphus: a proposal whose mode does not match is refused, the right one is confirmed with the auditor disabled.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "propose_goal_draft",
          "arguments": {
            "objective": "1) read the code, done when the module is understood. 2) write the port, done when the tests pass.",
            "sisyphus": false
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "propose_goal_draft",
          "arguments": {
            "objective": "1) read the code, done when the module is understood. 2) write the port, done when the tests pass.",
            "sisyphus": true
          }
        }
      ]
    },
    {
      "text": "unused"
    }
  ],
  "steps": [
    {
      "name": "draft",
      "rpc": {
        "type": "prompt",
        "message": "/sisyphus Port the module"
      },
      "ui": [
        {
          "value": "Disabled \u2014 skip the completion audit"
        },
        {
          "value": "1. Confirm \u2014 create this goal now (Recommended)"
        }
      ],
      "wait": "agent_end"
    },
    {
      "name": "cmd",
      "rpc": {
        "type": "prompt",
        "message": "/goal-status verbose"
      }
    }
  ],
  "files": {
    ".pi/pi-goal-x-settings.json": "{\"maxAutonomousRuns\": 0}"
  },
  "normalize": [
    {
      "pattern": "(?s)<docs>\\n(?:PiG|Pi) documentation.*",
      "replacement": "<docs>"
    },
    {
      "pattern": "(^|[^a-z0-9])[mn][a-z0-9]{7}-[a-z0-9]{6}\\b",
      "replacement": "${1}<goal-id>"
    },
    {
      "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z",
      "replacement": "<iso>"
    },
    {
      "pattern": "active_goal_\\d{16}_",
      "replacement": "active_goal_<stamp>_"
    },
    {
      "pattern": "\\b20(?:2[1-9]|[3-9]\\d)-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\b",
      "replacement": "<now>"
    },
    {
      "pattern": "Context snapshot: \\d+/(\\d+) tokens \\(\\d+%\\)",
      "replacement": "Context snapshot: <tokens>/${1} tokens (<pct>)"
    }
  ]
}
