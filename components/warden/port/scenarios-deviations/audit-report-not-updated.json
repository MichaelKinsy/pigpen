{
  "name": "audit-report-not-updated",
  "description": "D16 deviation scenario. /warden audit with a report from an earlier run: the original swallows the audit's own prompt (golden-deviations/original: no model request), the port sends it, the agent answers in chat, and the outcome is stale.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "files": {
    "package.json": "{\"name\":\"demo\"}\n",
    "src/classify.ts": "export function kind(t: string) { return /error/.test(t) ? \"bad\" : \"ok\"; }\n",
    ".pi-warden/audit-report.html": "<html>old</html>"
  },
  "steps": [
    {
      "name": "audit",
      "rpc": {
        "type": "prompt",
        "message": "/warden audit"
      },
      "ui": [
        {
          "confirmed": true
        }
      ]
    }
  ],
  "llm": [
    {
      "text": "the audit prompt reached the model"
    }
  ]
}
