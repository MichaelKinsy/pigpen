{
  "name": "write-to-ssh-directory-runs-offline",
  "description": "The write tool is not guarded offline in either: writing under ~/.ssh runs.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "toolCalls": [
        {
          "name": "write",
          "arguments": {
            "path": "~/.ssh/authorized_keys",
            "content": "ssh-rsa AAAA\n"
          }
        }
      ]
    },
    {
      "text": "ok"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "add my key"
      }
    }
  ]
}
