{
  "name": "sql-hosted-select-warns",
  "description": "A SELECT against a managed database is an elevated warning (sql-hosted).",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "psql \"postgresql://postgres.ref:pw@aws-0-us-east-1.pooler.supabase.com:6543/postgres\" -c 'SELECT count(*) FROM users'"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "count the users"
      }
    }
  ]
}
