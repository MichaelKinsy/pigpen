{
  "name": "waste-recheck-note",
  "description": "The same check re-run through a different output filter earns a note to run it once without a pipe.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    },
    "make": {
      "mode": "canned",
      "stdout": "tests 5\nok\n",
      "stderr": "",
      "exit": 0
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "make test 2>&1 | tail -3"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "make test 2>&1 | grep ok"
          }
        }
      ]
    },
    {
      "text": "stop"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ]
}
