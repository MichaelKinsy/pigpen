{
  "name": "held-call-released-by-approval",
  "description": "After a hold, a user reply that approves the action releases the same call.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "git push --force origin main"
          }
        }
      ]
    },
    {
      "text": "held; asking you"
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "git push --force origin main"
          }
        }
      ]
    },
    {
      "text": "pushed"
    }
  ],
  "steps": [
    {
      "name": "01-prompt",
      "rpc": {
        "type": "prompt",
        "message": "push my branch"
      }
    },
    {
      "name": "02-approve",
      "rpc": {
        "type": "prompt",
        "message": "yes, go ahead and force push it"
      }
    }
  ]
}
