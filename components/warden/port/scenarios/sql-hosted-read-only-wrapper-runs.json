{
  "name": "sql-hosted-read-only-wrapper-runs",
  "description": "A read-only transaction that rolls back is quiet even against a managed database.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "psql \"postgresql://postgres.ref:pw@aws-0-us-east-1.pooler.supabase.com:6543/postgres\" -c \"BEGIN READ ONLY; SELECT count(*) FROM users; ROLLBACK;\""
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "count the users safely"
      }
    }
  ]
}
