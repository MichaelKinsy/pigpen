{
  "name": "audit-declined-sends-nothing",
  "description": "/warden audit asks for confirmation; declining sends the model nothing.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "files": {
    "package.json": "{\"name\":\"demo\"}\n",
    "src/classify.ts": "export function kind(t: string) { return /error/.test(t) ? \"bad\" : \"ok\"; }\n"
  },
  "steps": [
    {
      "name": "audit",
      "rpc": {
        "type": "prompt",
        "message": "/warden audit"
      },
      "ui": [
        {
          "confirmed": false
        }
      ]
    }
  ],
  "llm": [
    {
      "text": "unexpected model request"
    }
  ]
}
