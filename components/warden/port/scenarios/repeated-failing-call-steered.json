{
  "name": "repeated-failing-call-steered",
  "description": "The same failing command repeated is caught as a stuck loop and the agent is steered.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "cat missing-file.txt"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "cat missing-file.txt"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "cat missing-file.txt"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "cat missing-file.txt"
          }
        }
      ]
    },
    {
      "text": "giving up"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "read missing-file.txt"
      }
    }
  ]
}
