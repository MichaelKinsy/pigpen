{
  "name": "audit-prompt-blocked-by-its-own-input-handler",
  "description": "/warden audit on Pi 1.3.0: the audit's own sendUserMessage raises the input event, the running-audit handler answers it as handled (original behavior, PORT.md A1), so the model receives no prompt and the outcome is `missing`.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "files": {
    "package.json": "{\"name\":\"demo\"}\n",
    "src/classify.ts": "export function kind(t: string) { return /error/.test(t) ? \"bad\" : \"ok\"; }\n"
  },
  "steps": [
    {
      "name": "audit",
      "rpc": {
        "type": "prompt",
        "message": "/warden audit"
      },
      "ui": [
        {
          "confirmed": true
        }
      ]
    }
  ],
  "llm": [
    {
      "text": "the audit prompt reached the model"
    }
  ]
}
