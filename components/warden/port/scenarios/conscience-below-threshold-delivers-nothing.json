{
  "name": "conscience-below-threshold-delivers-nothing",
  "description": "The judge rates the skill at the related level only: nothing is recommended.",
  "env": {
    "PIGPEN_WARDEN_ENABLED": "1",
    "PIGPEN_WARDEN_STEER_VISIBLE": "0",
    "FAKE_JUDGE_KEY": "fake-judge-key",
    "TYPESAFE_API_KEY": "fake-judge-key",
    "TYPESAFE_BASE_URL": "{{server:judge}}",
    "PIGPEN_WARDEN_BACKEND": "typesafe"
  },
  "commands": {
    "git": {
      "mode": "missing"
    }
  },
  "args": [
    "--tools",
    "read,bash,edit,write",
    "--skill",
    "skills/impeccable"
  ],
  "capture": [
    "response",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start",
    "tool_execution_end",
    "message_end"
  ],
  "llm": [
    {
      "text": "ok"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "design a landing page"
      }
    }
  ],
  "files": {
    "skills/impeccable/SKILL.md": "---\nname: impeccable\ndescription: Frontend interface design, polish, and UX\n---\n\nPolish the interface: align spacing, tighten type, check contrast.\n"
  },
  "servers": {
    "judge": {
      "routes": [
        {
          "method": "GET",
          "path": "/v1/models",
          "json": {
            "models": [
              {
                "name": "jev-latest",
                "description": "",
                "release_date": "2026-01-01"
              }
            ]
          }
        },
        {
          "method": "POST",
          "path": "/*",
          "json": {
            "model": "jev-1.13.0",
            "answers": {
              "conscience_disposition": {
                "type": "choice",
                "choice": "advance",
                "confidence": 0.9,
                "probabilities": {
                  "advance": 0.9,
                  "awaiting_user": 0.0333,
                  "no_gap": 0.0333,
                  "unclear": 0.0333
                }
              },
              "c1": {
                "type": "score",
                "score": 1,
                "confidence": 0.8,
                "legend": {
                  "0": "level 0",
                  "1": "level 1",
                  "2": "level 2",
                  "3": "level 3"
                },
                "probabilities": {
                  "0": 0.1,
                  "1": 0.8,
                  "2": 0.05,
                  "3": 0.05
                }
              }
            },
            "usage": {
              "input_tokens": 50,
              "output_tokens": 0
            }
          }
        }
      ]
    }
  },
  "agentFiles": {
    "pi-warden/config.json": "{\"notices\": false, \"rules\": {\"enabled\": false}, \"slop\": {\"enabled\": false}, \"security\": {\"enabled\": false}, \"action\": {\"feedbackLog\": false}, \"conscience\": {\"enabled\": true, \"skills\": {\"mode\": \"recommend\", \"exclude\": []}, \"tools\": {\"enabled\": false, \"exclude\": []}, \"recommendThreshold\": 0.5}, \"typesafe\": true, \"typesafeBackend\": {\"label\": \"Fake judge\", \"host\": \"{{server:judge}}\", \"keyEnv\": \"FAKE_JUDGE_KEY\", \"defaultModel\": \"jev-latest\"}}"
  },
  "homeFiles": {
    "pigpen-warden/config.json": "{\"conscience\": {\"enabled\": true, \"skills\": {\"mode\": \"recommend\", \"exclude\": []}, \"tools\": {\"enabled\": false, \"exclude\": []}, \"recommendThreshold\": 0.5}}"
  }
}
