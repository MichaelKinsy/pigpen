{
  "name": "universal-allow-bash-gated",
  "description": "A universal allow with an explicit bash policy raises no warning.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo hello"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "rm x"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "do the work"
      }
    }
  ],
  "files": {},
  "agentFiles": {
    "extensions/pi-permission-system/config.json": "{\n  \"permission\": {\n    \"path\": \"allow\",\n    \"external_directory\": \"allow\",\n    \"*\": \"allow\",\n    \"bash\": {\n      \"*\": \"allow\",\n      \"rm *\": \"deny\"\n    }\n  }\n}"
  }
}
