    "extensions/pi-permission-system/config.json": "{\n  // comment\n  \"permission\": {\"path\": \"allow\", \"external_directory\": \"allow\", \"*\": \"allow\",\n    \"bash\": {\"*\": \"allow\", \"rm *\": \"deny\"}} /* end */\n}"
  }
}
