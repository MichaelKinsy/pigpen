{
  "name": "bash-patterns",
  "description": "Simple bash commands against a deny-by-default pattern map, with a reason.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "git status"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "npm install"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo bye"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo ok"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "git status --short"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "npm"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo  ok"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "do the work"
      }
    }
  ],
  "files": {},
  "agentFiles": {
    "extensions/pi-permission-system/config.json": "{\n  \"permission\": {\n    \"path\": \"allow\",\n    \"external_directory\": \"allow\",\n    \"bash\": {\n      \"*\": \"deny\",\n      \"git status\": \"allow\",\n      \"npm *\": {\n        \"action\": \"deny\",\n        \"reason\": \"Use pnpm instead\"\n      },\n      \"echo ok\": \"allow\"\n    }\n  }\n}"
  },
  "commands": {
    "npm": {
      "mode": "missing"
    }
  }
}
