{
  "name": "tools-allowed",
  "description": "Allowed built-in tools: a path-bearing tool and bash.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "read",
          "arguments": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo hello"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "do the work"
      }
    }
  ],
  "files": {
    "a.txt": "hello\n"
  },
  "agentFiles": {
    "extensions/pi-permission-system/config.json": "{\n  \"permission\": {\n    \"path\": \"allow\",\n    \"external_directory\": \"allow\",\n    \"read\": \"allow\",\n    \"bash\": \"allow\"\n  }\n}"
  }
}
