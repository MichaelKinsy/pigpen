{
  "name": "pi-opencode-free",
  "version": "0.2.0",
  "description": "Zero-daemon, pure-passthrough native Pi extension connecting directly to OpenCode Zen API",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Pedro Alexis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrostarkealexis/pi-opencode-free.git"
  },
  "bugs": "https://github.com/pedrostarkealexis/pi-opencode-free/issues",
  "homepage": "https://github.com/pedrostarkealexis/pi-opencode-free#readme",
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "opencode",
    "free-models"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "bun test src/",
    "smoke": "bun scripts/smoke-real.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
