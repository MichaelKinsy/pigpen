{
  "name": "error-provider-rejects",
  "description": "The provider answers 400: the assistant message ends with stopReason error and its errorMessage; the llm run ends with that error, the turn and the root carry it.",
  "commands": {
    "git": {}
  },
  "agentFiles": {
    "models.json": "{\"providers\":{\"oai\":{\"baseUrl\":\"{{server:model}}/v1\",\"api\":\"openai-completions\",\"apiKey\":\"eq-key\",\"models\":[{\"id\":\"m-1\",\"name\":\"m-1\",\"reasoning\":false,\"input\":[\"text\"],\"contextWindow\":100000,\"maxTokens\":4096,\"cost\":{\"input\":0,\"output\":0,\"cacheRead\":0,\"cacheWrite\":0}}]}}}"
  },
  "args": [
    "--provider",
    "oai",
    "--model",
    "m-1"
  ],
  "servers": {
    "ls": {
      "routes": [
        {
          "method": "GET",
          "path": "/info",
          "json": {
            "version": "mock",
            "license_expiration_time": null,
            "batch_ingest_config": {
              "use_multipart_endpoint": true,
              "scale_up_qsize_trigger": 1000,
              "scale_up_nthreads_limit": 16,
              "scale_down_nempty_trigger": 4,
              "size_limit": 100,
              "size_limit_bytes": 20971520
            },
            "instance_flags": {
              "gzip_body_enabled": false
            }
          }
        },
        {
          "method": "POST",
          "path": "/runs/multipart",
          "json": {}
        },
        {
          "method": "POST",
          "path": "/runs/batch",
          "json": {}
        },
        {
          "method": "POST",
          "path": "/runs",
          "json": {}
        },
        {
          "method": "PATCH",
          "path": "/runs/*",
          "json": {}
        }
      ],
      "recordHeaders": [
        "x-api-key",
        "x-tenant-id",
        "authorization",
        "content-encoding"
      ]
    },
    "model": {
      "routes": [
        {
          "method": "POST",
          "path": "/v1/chat/completions",
          "headers": {
            "Content-Type": "application/json"
          },
          "status": 400,
          "body": "{\"error\":{\"message\":\"the fake provider rejects this request\",\"type\":\"invalid_request_error\"}}"
        }
      ]
    }
  },
  "env": {
    "TRACE_TO_LANGSMITH": "true",
    "LANGSMITH_PI_ENDPOINT": "{{server:ls}}",
    "LANGSMITH_PI_API_KEY": "ls-test-key"
  },
  "steps": [
    {
      "rpc": {
        "type": "prompt",
        "message": "hello"
      }
    }
  ],
  "settleMs": 700,
  "tailMs": 1500,
  "capture": [
    "response",
    "extension_ui_request",
    "extension_error",
    "tool_execution_start",
    "tool_execution_end"
  ],
  "normalize": [
    {
      "pattern": "----LangSmithFormBoundary[0-9a-z]+",
      "replacement": "<boundary>"
    },
    {
      "pattern": "[0-9]{8}T[0-9]{12}Z",
      "replacement": "<ts>"
    },
    {
      "pattern": "\"(start_time|end_time|timestamp|durationMs)\":[0-9]+",
      "replacement": "\"$1\":<ts:num>"
    },
    {
      "pattern": "\"role\":\"system\",\"content\":\"(?:[^\"\\\\]|\\\\.)*\"",
      "replacement": "\"role\":\"system\",\"content\":\"<host-prompt>\""
    },
    {
      "pattern": "\"sections\":\\{.*?\\},\"timestamp\"",
      "replacement": "\"sections\":\"<host-prompt>\",\"timestamp\""
    },
    {
      "pattern": "\"local_username\":\"[^\"]*\"",
      "replacement": "\"local_username\":\"<user>\""
    },
    {
      "pattern": "\"runtime\":\"(node|go)\"",
      "replacement": "\"runtime\":\"<d1>\""
    },
    {
      "pattern": "\"sdk\":\"[^\"]*\"",
      "replacement": "\"sdk\":\"<d1>\""
    },
    {
      "pattern": "\"sdk_version\":\"[^\"]*\"",
      "replacement": "\"sdk_version\":\"<d1>\""
    },
    {
      "pattern": "length=[0-9]+",
      "replacement": "length=<n>"
    }
  ]
}
