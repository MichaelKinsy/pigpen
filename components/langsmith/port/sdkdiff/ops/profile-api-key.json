{
  "name": "profile-api-key",
  "description": "No env credentials: the CLI profile (LANGSMITH_CONFIG_FILE, relative) supplies api_key, api_url and workspace.",
  "env": {
    "LANGSMITH_CONFIG_FILE": "profile.json"
  },
  "files": {
    "profile.json": {
      "current_profile": "dev",
      "profiles": {
        "dev": {
          "api_key": "profile-key",
          "api_url": "{{endpoint}}",
          "workspace_id": "pw-1"
        }
      }
    }
  },
  "ops": [
    {
      "op": "client",
      "as": "c",
      "config": {}
    },
    {
      "op": "runTree",
      "as": "root",
      "client": "c",
      "config": {
        "id": "0198a000-0000-7000-8000-000000000001",
        "name": "Pi agent run",
        "run_type": "chain",
        "start_time": 1790000000000,
        "project_name": "proj",
        "inputs": {
          "prompt": "hi",
          "imageCount": 0
        }
      }
    },
    {
      "op": "postRun",
      "run": "root"
    },
    {
      "op": "end",
      "run": "root",
      "outputs": {
        "r": 1
      },
      "endTime": 1790000005000
    },
    {
      "op": "patchRun",
      "run": "root"
    },
    {
      "op": "awaitPendingTraceBatches",
      "client": "c"
    }
  ]
}
