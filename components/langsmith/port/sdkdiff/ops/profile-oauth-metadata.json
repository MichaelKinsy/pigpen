{
  "name": "profile-oauth-metadata",
  "description": "OAuth discovery document served: the token endpoint comes from the document.",
  "env": {
    "LANGSMITH_CONFIG_FILE": "profile.json"
  },
  "files": {
    "profile.json": {
      "current_profile": "dev",
      "profiles": {
        "dev": {
          "api_url": "{{endpoint}}",
          "oauth": {
            "refresh_token": "ref-1"
          }
        }
      }
    }
  },
  "readFiles": [
    "profile.json"
  ],
  "mockls": {
    "oauthMetadata": {
      "issuer": "{{base}}",
      "token_endpoint": "{{base}}/custom/oauth/token",
      "device_authorization_endpoint": "{{base}}/dev"
    },
    "token": {
      "access_token": "tok-meta",
      "expires_in": 60
    }
  },
  "ops": [
    {
      "op": "client",
      "as": "c",
      "config": {}
    },
    {
      "op": "runTree",
      "as": "root",
      "client": "c",
      "config": {
        "id": "0198a000-0000-7000-8000-000000000001",
        "name": "Pi agent run",
        "run_type": "chain",
        "start_time": 1790000000000,
        "project_name": "proj",
        "inputs": {
          "prompt": "hi",
          "imageCount": 0
        }
      }
    },
    {
      "op": "postRun",
      "run": "root"
    },
    {
      "op": "end",
      "run": "root",
      "outputs": {
        "r": 1
      },
      "endTime": 1790000005000
    },
    {
      "op": "patchRun",
      "run": "root"
    },
    {
      "op": "awaitPendingTraceBatches",
      "client": "c"
    }
  ]
}
