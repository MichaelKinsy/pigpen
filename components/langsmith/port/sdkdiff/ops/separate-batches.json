{
  "name": "separate-batches",
  "description": "postRun, a pause longer than the 250 ms aggregation window, then patchRun: a create-only and an update-only request.",
  "ops": [
    {
      "op": "client",
      "as": "c",
      "config": {
        "apiUrl": "{{endpoint}}",
        "apiKey": "ls-key"
      }
    },
    {
      "op": "runTree",
      "as": "root",
      "client": "c",
      "config": {
        "id": "0198a000-0000-7000-8000-000000000001",
        "name": "Pi agent run",
        "run_type": "chain",
        "start_time": 1790000000000,
        "project_name": "proj",
        "inputs": {
          "prompt": "hi",
          "imageCount": 0
        }
      }
    },
    {
      "op": "postRun",
      "run": "root"
    },
    {
      "op": "sleep",
      "ms": 600
    },
    {
      "op": "end",
      "run": "root",
      "outputs": {
        "done": true
      },
      "endTime": 1790000005000
    },
    {
      "op": "patchRun",
      "run": "root"
    },
    {
      "op": "awaitPendingTraceBatches",
      "client": "c"
    }
  ]
}
