{
  "name": "lock-clear-writes-base-id",
  "description": "Bare `clear` removes the lock of the current model and writes the base id as the default; clearing again says there is none.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "cat \"$PI_CODING_AGENT_DIR/settings.json\""
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "env": {
    "OPENROUTER_API_KEY": "eq-or-key"
  },
  "args": [
    "--provider",
    "openrouter",
    "--model",
    "google/gemma-4-26b-a4b-it"
  ],
  "agentFiles": {
    "settings.json": "{\"defaultProvider\": \"openrouter\", \"defaultModel\": \"google/gemma-4-26b-a4b-it:deepseek\", \"theme\": \"dark\"}\n",
    "pi-tweaks-settings.json": "{\"version\": 1, \"rememberModel\": {\"enabled\": false}, \"openrouterModelProviderPref\": {\"enabled\": true, \"locks\": {\"google/gemma-4-26b-a4b-it\": \"deepseek\"}}}"
  },
  "steps": [
    {
      "name": "clear",
      "rpc": {
        "type": "prompt",
        "message": "/pt-openrouter-lock-provider clear"
      }
    },
    {
      "name": "clear-again",
      "rpc": {
        "type": "prompt",
        "message": "/pt-openrouter-lock-provider clear"
      }
    },
    {
      "name": "set-eq-llm",
      "rpc": {
        "type": "set_model",
        "provider": "eq-llm",
        "modelId": "eq-1"
      }
    },
    {
      "name": "read-settings",
      "rpc": {
        "type": "prompt",
        "message": "show settings"
      }
    }
  ]
}
