{
  "name": "lock-multi-word-argument",
  "description": "The whole argument is the provider slug, in the message and in the variant written into settings.json.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "cat \"$PI_CODING_AGENT_DIR/settings.json\""
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "env": {
    "OPENROUTER_API_KEY": "eq-or-key"
  },
  "args": [
    "--provider",
    "openrouter",
    "--model",
    "google/gemma-4-26b-a4b-it"
  ],
  "agentFiles": {
    "settings.json": "{}\n",
    "pi-tweaks-settings.json": "{\"version\": 1, \"rememberModel\": {\"enabled\": false}}"
  },
  "steps": [
    {
      "name": "lock",
      "rpc": {
        "type": "prompt",
        "message": "/pt-openrouter-lock-provider a b"
      }
    },
    {
      "name": "list",
      "rpc": {
        "type": "prompt",
        "message": "/pt-openrouter-lock-provider list"
      }
    },
    {
      "name": "set-eq-llm",
      "rpc": {
        "type": "set_model",
        "provider": "eq-llm",
        "modelId": "eq-1"
      }
    },
    {
      "name": "read-settings",
      "rpc": {
        "type": "prompt",
        "message": "show settings"
      }
    }
  ]
}
