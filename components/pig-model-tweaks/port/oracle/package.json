{
	"name": "@liyu1981/pi-tweaks",
	"version": "0.1.1",
	"description": "pi extensions: remembered model, OpenRouter provider lock, and model preference guard",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"openrouter",
		"model-preferences"
	],
	"license": "MIT",
	"author": "Yu Li <liyu1981@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/liyu1981/pi-tweaks.git"
	},
	"homepage": "https://github.com/liyu1981/pi-tweaks#readme",
	"bugs": {
		"url": "https://github.com/liyu1981/pi-tweaks/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"extensions",
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "^22.19.0",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"dev": "pi -e .",
		"install:local": "pi install .",
		"uninstall:local": "pi remove .",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run check"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
