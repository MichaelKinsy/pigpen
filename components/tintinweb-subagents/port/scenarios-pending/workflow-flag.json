{
  "name": "workflow-flag",
  "description": "--subagents-workflow-file runs a script at session start, appends the card entry and hands the result over as next-turn context.",
  "llm": [
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"schedulingEnabled\": false, \"worktreeIsolation\": false}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ],
  "files": {
    "flow.js": "export const meta = { name: \"flagged\", description: \"from the flag\" };\nlog(\"scanned\");\nreturn \"all clear\";"
  },
  "args": [
    "--subagents-workflow-file=flow.js"
  ],
  "tailMs": 2500,
  "volatileNumbers": [
    "message.details.durationMs"
  ],
  "normalize": [
    {
      "pattern": "pi-subagents-[0-9]+/[^/]+/",
      "replacement": "pi-subagents-<uid>/<cwd-slug>/"
    }
  ]
}
