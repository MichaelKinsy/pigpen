{
  "name": "desc-custom-empty-project-file",
  "description": "an empty project template is ignored and the global one is read.",
  "llm": [
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"toolDescriptionMode\": \"custom\", \"schedulingEnabled\": true, \"worktreeIsolation\": true, \"workflowsEnabled\": false}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "hello"
      }
    }
  ],
  "files": {
    ".pi/agent-tool-description.md": "  \n"
  },
  "agentFiles": {
    "agent-tool-description.md": "GLOBAL AFTER EMPTY {{agentDir}}"
  }
}
