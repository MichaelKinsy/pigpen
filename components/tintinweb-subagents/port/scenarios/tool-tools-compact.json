{
  "name": "tool-tools-compact",
  "description": "toolDescriptionMode compact: the short Agent description with the one-line type list.",
  "llm": [
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"workflowsEnabled\": false, \"schedulingEnabled\": false, \"worktreeIsolation\": false, \"toolDescriptionMode\": \"compact\"}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "hello"
      }
    }
  ]
}
