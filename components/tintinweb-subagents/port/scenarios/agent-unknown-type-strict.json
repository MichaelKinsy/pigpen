{
  "name": "agent-unknown-type-strict",
  "description": "With fallbackSubagent none an unknown type is refused, naming the available ones.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "Agent",
          "arguments": {
            "prompt": "x",
            "description": "d",
            "subagent_type": "typoo"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"workflowsEnabled\": false, \"schedulingEnabled\": false, \"worktreeIsolation\": false, \"fallbackSubagent\": \"none\"}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ]
}
