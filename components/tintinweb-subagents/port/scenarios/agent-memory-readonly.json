{
  "name": "agent-memory-readonly",
  "description": "An agent that cannot write gets the read-only memory block.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "Agent",
          "arguments": {
            "prompt": "Recall.",
            "description": "recall",
            "subagent_type": "ro",
            "run_in_background": false
          }
        }
      ]
    },
    {
      "text": "REMEMBERED"
    },
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"workflowsEnabled\": false, \"schedulingEnabled\": false, \"fleetView\": false, \"widgetMode\": \"off\"}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "real"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ],
  "files": {
    ".pi/agents/ro.md": "---\ndescription: Reads memory\ntools: read, grep\nmemory: local\n---\nRead memory.\n",
    ".pi/agent-memory-local/ro/MEMORY.md": "# Memory\n- the build needs RUN_ME=1\n"
  }
}
