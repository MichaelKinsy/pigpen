{
  "name": "workflow-run-throws",
  "description": "A script that throws is a failed run: the notification says Error and carries the reason.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "SubagentWorkflow",
          "arguments": {
            "script": "export const meta = { name: \"boom\", description: \"throws\" };\nthrow new Error(\"script blew up\");"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"schedulingEnabled\": false, \"worktreeIsolation\": false}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ],
  "tailMs": 2500
}
