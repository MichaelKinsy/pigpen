{
  "name": "mention-direct-headless",
  "description": "In direct mode a headless prompt is left to the main model.",
  "llm": [
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"workflowsEnabled\": false, \"schedulingEnabled\": false, \"worktreeIsolation\": false, \"agentMentions\": \"direct\"}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "@explore find the flaky test"
      }
    }
  ]
}
