{
  "name": "workflow-title-ignored",
  "description": "title and description are accepted and ignored.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "SubagentWorkflow",
          "arguments": {
            "script": "export const meta = { name: \"titled\", description: \"d\" };\nreturn 1;",
            "title": "Nightly",
            "description": "x"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"schedulingEnabled\": false, \"worktreeIsolation\": false}' > .pi/subagents.json"
    ]
  ],
  "commands": {
    "git": {
      "mode": "missing"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ],
  "tailMs": 2500
}
