{
  "name": "agent-isolation-agent-file-off",
  "description": "An agent file with isolation: off vetoes the call's worktree.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "Agent",
          "arguments": {
            "prompt": "Create the marker file.",
            "description": "worktree work",
            "subagent_type": "nowt",
            "run_in_background": false,
            "isolation": "worktree"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo isolated > agent-work.txt"
          }
        }
      ]
    },
    {
      "text": "CHILD-EDITED-ITS-TREE"
    },
    {
      "text": "done"
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p .pi && printf '%s' '{\"workflowsEnabled\": false, \"schedulingEnabled\": false, \"fleetView\": false, \"widgetMode\": \"off\"}' > .pi/subagents.json"
    ],
    [
      "sh",
      "-c",
      "git init -q && echo '# repo' > README.md && git add README.md && git commit -q -m initial"
    ]
  ],
  "commands": {
    "git": {
      "mode": "real"
    },
    "gh": {
      "mode": "missing"
    }
  },
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ],
  "files": {
    ".pi/agents/nowt.md": "---\ndescription: Never isolated\nisolation: off\n---\nWork in place.\n"
  }
}
