// PiG's extension resolver reads this file (extension/source: goWorkspaceModuleRoots) to find the shared pitui module,
// and adds the require and replace itself when it fuses or builds. The relative path is the same in the repository and
// in a staged Piglet (packages/<package>/extensions/<name> -> packages/pitui).
use (
	.
	../../../pitui
)
