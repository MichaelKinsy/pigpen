{
  "name": "enforce-decline",
  "description": "Enforce mode, the user declines the confirmation: the call is blocked with the gate's reason.",
  "agentFiles": {
    "pi-jev.json": "{\"enabled\": true, \"acknowledged\": true, \"display\": \"plain\", \"backend\": \"typesafe\", \"endpoint\": \"{{server:jev}}/v1/systemone\", \"model\": \"jev-eq\", \"retries\": 0, \"timeoutMs\": 5000, \"gate\": {\"mode\": \"enforce\"}}"
  },
  "env": {
    "TYPESAFE_API_KEY": "tsk-eq-key-0123456789"
  },
  "servers": {
    "jev": {
      "recordHeaders": [
        "authorization"
      ],
      "routes": [
        {
          "method": "POST",
          "path": "/v1/systemone",
          "body": "{\"model\": \"jev-eq\", \"answers\": {\"destructive\": {\"type\": \"noul\", \"noul\": 0.99}, \"exfiltration\": {\"type\": \"noul\", \"noul\": 0.79}, \"beyond_scope\": {\"type\": \"noul\", \"noul\": 0.98}, \"impact\": {\"type\": \"score\", \"score\": 3.0, \"confidence\": 0.91, \"legend\": {\"0\": \"None, it only reads\", \"1\": \"Small\", \"2\": \"Large\", \"3\": \"Severe\"}, \"probabilities\": {\"0\": 0.05, \"1\": 0.1, \"2\": 0.15, \"3\": 0.7}}}, \"usage\": {\"input_tokens\": 100, \"output_tokens\": 4}}",
          "headers": {
            "Content-Type": "application/json"
          },
          "times": 1
        }
      ]
    }
  },
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bash",
          "arguments": {
            "command": "echo hi"
          }
        }
      ]
    },
    {
      "text": "blocked"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "please run echo hi"
      },
      "ui": [
        {
          "confirmed": false
        }
      ]
    }
  ]
}
