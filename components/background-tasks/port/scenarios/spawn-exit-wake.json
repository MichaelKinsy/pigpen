{
  "name": "spawn-exit-wake",
  "description": "bg_task spawn of a short command, then the exit wake starts a turn that reaches the model.",
  "commands": {
    "sh": {
      "mode": "real"
    },
    "ps": {
      "mode": "real"
    },
    "nice": {
      "mode": "real"
    },
    "ionice": {
      "mode": "real"
    },
    "systemctl": {
      "mode": "missing"
    },
    "systemd-run": {
      "mode": "missing"
    },
    "where": {
      "mode": "missing"
    },
    "which": {
      "mode": "real"
    },
    "taskkill": {
      "mode": "missing"
    }
  },
  "llm": [
    {
      "toolCalls": [
        {
          "name": "bg_task",
          "arguments": {
            "action": "spawn",
            "command": "printf 'hello\\n'",
            "title": "say hello"
          }
        }
      ]
    },
    {
      "text": "started"
    },
    {
      "text": "the task finished"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "run it in the background"
      }
    }
  ],
  "capture": [
    "response",
    "extension_ui_request",
    "extension_error",
    "agent_start",
    "agent_end",
    "turn_start",
    "turn_end",
    "tool_execution_start"
  ],
  "normalize": [
    {
      "pattern": "\\(pid \\d+\\)",
      "replacement": "(pid <pid>)"
    },
    {
      "pattern": "pid: \\d+",
      "replacement": "pid: <pid>"
    },
    {
      "pattern": "bg-(\\d+)-\\d{13}\\.log",
      "replacement": "bg-$1-<ms>.log"
    }
  ]
}
