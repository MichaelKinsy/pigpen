{
  "name": "command-completed-only",
  "description": "/todos with only completed tasks.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "c1"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "update",
            "id": 1,
            "status": "completed"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "plan the work"
      }
    },
    {
      "name": "todos",
      "rpc": {
        "type": "prompt",
        "message": "/todos"
      }
    }
  ]
}
