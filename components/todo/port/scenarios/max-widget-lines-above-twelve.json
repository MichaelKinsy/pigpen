{
  "name": "max-widget-lines-above-twelve",
  "description": "A config with maxWidgetLines 20: the tool and /todos run as usual with 6 tasks.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "task 1"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "task 2"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "task 3"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "task 4"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "task 5"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "create",
            "subject": "task 6"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "todo",
          "arguments": {
            "action": "update",
            "id": 1,
            "status": "completed"
          }
        },
        {
          "name": "todo",
          "arguments": {
            "action": "list"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "plan the work"
      }
    },
    {
      "name": "todos",
      "rpc": {
        "type": "prompt",
        "message": "/todos"
      }
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p \"$HOME/.config/rpiv-todo\" && printf '{\"maxWidgetLines\":20}' > \"$HOME/.config/rpiv-todo/config.json\""
    ]
  ]
}
