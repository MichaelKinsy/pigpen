{
  "name": "sub-empty-model",
  "description": "An empty model is refused on add and on update.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "add",
            "name": "x",
            "schedule": "0 0 0 * * *",
            "prompt": "p",
            "model": ""
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "update",
            "jobId": "mod0000001",
            "model": ""
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "go",
      "rpc": {
        "type": "prompt",
        "message": "go"
      }
    }
  ],
  "files": {
    ".pi/schedule-prompts.json": "{\n  \"jobs\": [\n    {\n      \"id\": \"mod0000001\",\n      \"name\": \"seeded\",\n      \"schedule\": \"0 0 1 * * *\",\n      \"prompt\": \"q\",\n      \"enabled\": true,\n      \"type\": \"cron\",\n      \"createdAt\": \"2026-01-01T00:00:00.000Z\",\n      \"runCount\": 0,\n      \"model\": \"eq-1\"\n    }\n  ],\n  \"version\": 1\n}"
  },
  "normalize": [
    {
      "pattern": "\\(([A-Za-z0-9_-]{10})\\)",
      "replacement": "(<id>)"
    },
    {
      "pattern": "\\\"id\\\": \\\"[A-Za-z0-9_-]{10}\\\"",
      "replacement": "\"id\": \"<id>\""
    },
    {
      "pattern": "^[A-Za-z0-9_-]{10}$",
      "replacement": "<id>"
    },
    {
      "pattern": "job-[A-Za-z0-9_-]{6}",
      "replacement": "job-<n>"
    }
  ]
}
