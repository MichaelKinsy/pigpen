{
  "name": "fire-once-tool",
  "description": "A one-shot added by the tool (+2s) fires once and disables itself; the next list shows it.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "add",
            "name": "once-soon",
            "schedule": "+2s",
            "type": "once",
            "prompt": "scheduled tick"
          }
        }
      ]
    },
    {
      "text": "scheduled"
    },
    {
      "text": "fired"
    },
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "list"
          }
        }
      ]
    },
    {
      "text": "listed"
    }
  ],
  "steps": [
    {
      "name": "add",
      "rpc": {
        "type": "prompt",
        "message": "add"
      }
    },
    {
      "name": "wait",
      "rpc": {
        "type": "get_state"
      },
      "settleMs": 3000
    },
    {
      "name": "after",
      "rpc": {
        "type": "prompt",
        "message": "after"
      }
    }
  ],
  "tailMs": 500,
  "normalize": [
    {
      "pattern": "\\(([A-Za-z0-9_-]{10})\\)",
      "replacement": "(<id>)"
    },
    {
      "pattern": "\\\"id\\\": \\\"[A-Za-z0-9_-]{10}\\\"",
      "replacement": "\"id\": \"<id>\""
    },
    {
      "pattern": "^[A-Za-z0-9_-]{10}$",
      "replacement": "<id>"
    },
    {
      "pattern": "job-[A-Za-z0-9_-]{6}",
      "replacement": "job-<n>"
    }
  ]
}
