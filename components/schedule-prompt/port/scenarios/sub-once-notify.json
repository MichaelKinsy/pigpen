{
  "name": "sub-once-notify",
  "description": "notify=true: the done marker wakes the parent, which answers.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "add",
            "name": "bg",
            "schedule": "+2s",
            "type": "once",
            "prompt": "summarize",
            "model": "eq-1",
            "notify": true
          }
        }
      ]
    },
    {
      "text": "scheduled"
    },
    {
      "text": "the subagent's answer"
    },
    {
      "text": "parent saw it"
    }
  ],
  "steps": [
    {
      "name": "add",
      "rpc": {
        "type": "prompt",
        "message": "add"
      }
    },
    {
      "name": "wait",
      "rpc": {
        "type": "get_state"
      },
      "settleMs": 3500
    }
  ],
  "tailMs": 500,
  "normalize": [
    {
      "pattern": "\\(([A-Za-z0-9_-]{10})\\)",
      "replacement": "(<id>)"
    },
    {
      "pattern": "\\\"id\\\": \\\"[A-Za-z0-9_-]{10}\\\"",
      "replacement": "\"id\": \"<id>\""
    },
    {
      "pattern": "^[A-Za-z0-9_-]{10}$",
      "replacement": "<id>"
    },
    {
      "pattern": "job-[A-Za-z0-9_-]{6}",
      "replacement": "job-<n>"
    }
  ]
}
