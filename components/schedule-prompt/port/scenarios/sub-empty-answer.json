{
  "name": "sub-empty-answer",
  "description": "A session that answers with nothing: the marker says so.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "add",
            "name": "bg",
            "schedule": "+2s",
            "type": "once",
            "prompt": "say nothing",
            "model": "eq-1"
          }
        }
      ]
    },
    {
      "text": "scheduled"
    },
    {
      "text": " "
    }
  ],
  "steps": [
    {
      "name": "add",
      "rpc": {
        "type": "prompt",
        "message": "add"
      }
    },
    {
      "name": "wait",
      "rpc": {
        "type": "get_state"
      },
      "settleMs": 3500
    }
  ],
  "tailMs": 500,
  "normalize": [
    {
      "pattern": "\\(([A-Za-z0-9_-]{10})\\)",
      "replacement": "(<id>)"
    },
    {
      "pattern": "\\\"id\\\": \\\"[A-Za-z0-9_-]{10}\\\"",
      "replacement": "\"id\": \"<id>\""
    },
    {
      "pattern": "^[A-Za-z0-9_-]{10}$",
      "replacement": "<id>"
    },
    {
      "pattern": "job-[A-Za-z0-9_-]{6}",
      "replacement": "job-<n>"
    }
  ]
}
