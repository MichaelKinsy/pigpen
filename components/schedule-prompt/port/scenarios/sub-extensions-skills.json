{
  "name": "sub-extensions-skills",
  "description": "extensions and skills true: the session binds extensions and loads skills; the answer still comes back.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "schedule_prompt",
          "arguments": {
            "action": "add",
            "name": "bg",
            "schedule": "+2s",
            "type": "once",
            "prompt": "check",
            "model": "eq-1",
            "extensions": true,
            "skills": true
          }
        }
      ]
    },
    {
      "text": "scheduled"
    },
    {
      "text": "with everything"
    }
  ],
  "steps": [
    {
      "name": "add",
      "rpc": {
        "type": "prompt",
        "message": "add"
      }
    },
    {
      "name": "wait",
      "rpc": {
        "type": "get_state"
      },
      "settleMs": 3500
    }
  ],
  "tailMs": 500,
  "normalize": [
    {
      "pattern": "\\(([A-Za-z0-9_-]{10})\\)",
      "replacement": "(<id>)"
    },
    {
      "pattern": "\\\"id\\\": \\\"[A-Za-z0-9_-]{10}\\\"",
      "replacement": "\"id\": \"<id>\""
    },
    {
      "pattern": "^[A-Za-z0-9_-]{10}$",
      "replacement": "<id>"
    },
    {
      "pattern": "job-[A-Za-z0-9_-]{6}",
      "replacement": "job-<n>"
    }
  ]
}
