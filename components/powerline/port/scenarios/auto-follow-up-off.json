{
 "name": "auto-follow-up-off",
 "description": "autoFollowUp is off (the default): a queued RPC prompt is plain steering and nothing is said.",
 "llm": [
  {
   "toolCalls": [
    {
     "name": "bash",
     "arguments": {
      "command": "sleep 2"
     }
    }
   ]
  },
  {
   "text": "done"
  },
  {
   "text": "ok"
  }
 ],
 "steps": [
  {
   "name": "start the task",
   "rpc": {
    "type": "prompt",
    "message": "fix the checkout bug"
   },
   "wait": "response"
  },
  {
   "name": "steer while the tool runs",
   "rpc": {
    "type": "prompt",
    "message": "also lint",
    "streamingBehavior": "steer"
   },
   "wait": "response"
  },
  {
   "name": "let the run finish",
   "rpc": {
    "type": "get_state"
   },
   "wait": "agent_end"
  }
 ],
 "agentFiles": {
  "settings.json": "{\"powerline\": {\"welcome\": false}}"
 }
}
