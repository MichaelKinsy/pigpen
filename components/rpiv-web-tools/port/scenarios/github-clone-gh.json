{
  "name": "github-clone-gh",
  "description": "With gh available and a small repository the clone command line is gh repo clone; an empty clone renders an empty tree, a ref adds --branch, and a repeat uses the cache.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "web_fetch",
          "arguments": {
            "url": "https://github.com/o/r"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "web_fetch",
          "arguments": {
            "url": "https://github.com/o/r/tree/dev/src"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "web_fetch",
          "arguments": {
            "url": "https://github.com/o/r/blob/dev/src/main.go"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "web_fetch",
          "arguments": {
            "url": "https://github.com/o/r/tree/dev/src"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "web_fetch",
          "arguments": {
            "url": "https://github.com/o/r"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "look it up"
      }
    }
  ],
  "setup": [
    [
      "sh",
      "-c",
      "mkdir -p \"$HOME/.config/rpiv-web-tools\" && printf '{\"interceptors\":{\"github\":{\"clonePath\":\"%s/clones\"}}}' \"$HOME\" > \"$HOME/.config/rpiv-web-tools/config.json\""
    ]
  ],
  "env": {
    "BRAVE_SEARCH_API_KEY": "scenario-key"
  },
  "commands": {
    "gh": {
      "mode": "canned",
      "stdout": "100",
      "exit": 0
    },
    "git": {
      "mode": "missing"
    }
  }
}
