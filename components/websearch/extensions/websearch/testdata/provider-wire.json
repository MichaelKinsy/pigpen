 {
  "name": "parallel mcp search anonymous with filters",
  "kind": "search",
  "fn": "searchWithParallelMcp",
  "env": {},
  "args": [
   "docs",
   {
    "numResults": 2,
    "domainFilter": [
     "example.com",
     "-private.docs.example.com"
    ],
    "recencyFilter": "week",
    "includeContent": true
   }
  ],
  "responses": [
   {
    "status": 200,
    "body": {
     "jsonrpc": "2.0",
     "id": 1,
     "result": {
      "structuredContent": {
       "results": [
        {
         "title": "Allowed",
         "url": "https://docs.example.com/a",
         "excerpts": [
          "Allowed excerpt"
         ]
        },
        {
         "title": "Excluded",
         "url": "https://private.docs.example.com/b",
         "excerpts": [
          "x"
         ]
        },
