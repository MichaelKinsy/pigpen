 {
  "name": "querit search and contents",
  "kind": "search",
  "fn": "searchWithQuerit",
  "env": {
   "QUERIT_API_KEY": "wire-querit-key"
  },
  "args": [
   "querit docs",
   {
    "includeContent": true,
    "numResults": 2,
    "recencyFilter": "day",
    "domainFilter": [
     "https://www.querit.ai/docs",
     "-example.com"
    ]
   }
  ],
  "responses": [
   {
    "status": 200,
    "body": {
     "error_code": 200,
     "error_msg": "",
     "results": {
      "result": [
       {
        "title": "Querit docs",
        "url": "https://www.querit.ai/en/docs",
        "snippet": " Real-time   search "
       },
       {
        "url": "https://www.querit.ai/two"
       }
      ]
     }
    }
   },
   {
    "status": 200,
    "body": {
     "error_code": 200,
     "error_msg": "",
     "results": [
      {
       "id": "a",
       "url": "https://www.querit.ai/en/docs",
       "content": "# Doc",
       "extrasMeta": {
        "title": "Doc title"
       }
      },
      {
       "id": "b",
       "url": "https://www.querit.ai/two",
       "content": "  "
      }
     ],
     "statuses": [
      {
       "id": "a",
       "status": "success"
      },
      {
       "id": "b",
       "status": "failed"
      }
     ]
    }
   }
  ],
  "expect": {
   "calls": [
    {
     "method": "POST",
     "url": "https://api.querit.ai/v1/search",
     "headers": {
      "accept": "application/json",
      "authorization": "Bearer wire-querit-key",
      "content-type": "application/json"
     },
     "body": {
      "query": "querit docs",
      "count": 2,
      "filters": {
       "sites": {
        "include": [
         "www.querit.ai"
        ],
        "exclude": [
         "example.com"
        ]
       },
       "timeRange": {
        "date": "d1"
       }
      }
     }
    },
    {
     "method": "POST",
     "url": "https://api.querit.ai/v1/contents",
     "headers": {
      "accept": "application/json",
      "authorization": "Bearer wire-querit-key",
      "content-type": "application/json"
     },
     "body": {
      "urls": [
       "https://www.querit.ai/en/docs",
       "https://www.querit.ai/two"
      ],
      "format": "markdown",
      "crawlTimeout": 10,
      "extrasMeta": true
     }
    }
   ],
   "result": {
    "answer": "Real-time search\nSource: Querit docs (https://www.querit.ai/en/docs)\n\nSource: https://www.querit.ai/two (https://www.querit.ai/two)",
    "results": [
     {
      "title": "Querit docs",
      "url": "https://www.querit.ai/en/docs",
      "snippet": "Real-time search"
     },
     {
      "title": "https://www.querit.ai/two",
      "url": "https://www.querit.ai/two",
      "snippet": ""
     }
    ],
    "inlineContent": [
     {
      "url": "https://www.querit.ai/en/docs",
      "title": "Doc title",
      "content": "# Doc",
      "error": null
     }
    ]
   },
   "error": null,
   "activity": [
    {
     "type": "api",
     "query": "querit docs",
     "status": 200
    }
   ]
  }
 },
