 {
  "name": "parallel search with a source policy",
  "kind": "search",
  "fn": "searchWithParallel",
  "env": {
   "PARALLEL_API_KEY": "pk_live_wire_parallel_key"
  },
  "args": [
   "parallel docs",
   {
    "includeContent": true,
    "numResults": 3,
    "domainFilter": [
     "docs.parallel.ai",
     "-example.com"
    ]
   }
  ],
  "responses": [
   {
    "status": 200,
    "body": {
     "results": [
      {
       "title": "Parallel Docs",
       "url": "https://docs.parallel.ai/search",
       "excerpts": [
        "First excerpt",
        "Second"
       ]
      },
      {
       "url": "https://x.example/none",
       "excerpts": []
      }
     ]
    }
   }
  ],
  "expect": {
   "calls": [
    {
     "method": "POST",
     "url": "https://api.parallel.ai/v1/search",
     "headers": {
      "content-type": "application/json",
      "x-api-key": "pk_live_wire_parallel_key"
     },
     "body": {
      "objective": "parallel docs",
      "search_queries": [
       "parallel docs"
      ],
      "advanced_settings": {
       "max_results": 3,
       "source_policy": {
        "include_domains": [
         "docs.parallel.ai"
        ],
        "exclude_domains": [
         "example.com"
        ]
       }
      }
     }
    }
   ],
   "result": {
    "answer": "First excerpt Second\nSource: Parallel Docs (https://docs.parallel.ai/search)",
    "results": [
     {
      "title": "Parallel Docs",
      "url": "https://docs.parallel.ai/search",
      "snippet": "First excerpt"
     },
     {
      "title": "Source 2",
      "url": "https://x.example/none",
      "snippet": ""
     }
    ],
    "inlineContent": [
     {
      "url": "https://docs.parallel.ai/search",
      "title": "Parallel Docs",
      "content": "First excerpt\n\nSecond",
      "error": null
     }
    ]
   },
   "error": null,
   "activity": [
    {
     "type": "api",
     "query": "parallel docs",
     "status": 200
    }
   ]
  }
 },
