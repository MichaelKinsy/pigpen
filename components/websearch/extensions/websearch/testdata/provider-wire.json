[
 {
  "name": "tinyfish search with filters, recency and inline content",
  "kind": "search",
  "fn": "searchWithTinyFish",
  "env": {
   "TINYFISH_API_KEY": "wire-tinyfish-key"
  },
  "args": [
   "tinyfish docs",
   {
    "includeContent": true,
    "numResults": 2,
    "recencyFilter": "week",
    "domainFilter": [
     "docs.tinyfish.ai",
     "-example.com"
    ]
   }
  ],
  "responses": [
   {
    "status": 200,
    "body": {
     "query": "tinyfish docs",
     "results": [
      {
       "title": "TinyFish Docs",
       "snippet": "  Search   and fetch  ",
       "url": "https://docs.tinyfish.ai/"
      },
      {
       "title": "",
       "snippet": "x",
       "url": "https://docs.tinyfish.ai/"
      },
      {
       "snippet": "no title",
       "url": "https://example.org/b"
      }
     ]
    }
   },
   {
    "status": 200,
    "body": {
     "results": [
      {
       "url": "https://docs.tinyfish.ai/",
       "final_url": "https://docs.tinyfish.ai/",
       "title": "TinyFish Docs",
       "text": "# Full"
      },
      {
       "url": "https://example.org/b",
       "text": {
        "a": 1,
        "b": [
         2
        ]
       }
      }
     ],
     "errors": []
    }
   }
  ],
  "expect": {
   "calls": [
    {
     "method": "GET",
     "url": "https://api.search.tinyfish.ai?query=tinyfish+docs&include_domains=docs.tinyfish.ai&exclude_domains=example.com&recency_minutes=10080",
     "headers": {
      "x-api-key": "wire-tinyfish-key"
     },
     "body": null
    },
    {
     "method": "POST",
     "url": "https://api.fetch.tinyfish.ai",
     "headers": {
      "content-type": "application/json",
      "x-api-key": "wire-tinyfish-key"
     },
     "body": {
      "urls": [
       "https://docs.tinyfish.ai/",
       "https://example.org/b"
      ],
      "format": "markdown",
      "per_url_timeout_ms": 110000
     }
    }
   ],
   "result": {
    "answer": "Search and fetch\nSource: TinyFish Docs (https://docs.tinyfish.ai/)\n\nno title\nSource: https://example.org/b (https://example.org/b)",
    "results": [
     {
      "title": "TinyFish Docs",
      "url": "https://docs.tinyfish.ai/",
      "snippet": "Search and fetch"
     },
     {
      "title": "https://example.org/b",
      "url": "https://example.org/b",
      "snippet": "no title"
     }
    ],
    "inlineContent": [
     {
      "url": "https://docs.tinyfish.ai/",
      "title": "TinyFish Docs",
      "content": "# Full",
      "error": null
     },
     {
      "url": "https://example.org/b",
      "title": "",
      "content": "{\n  \"a\": 1,\n  \"b\": [\n    2\n  ]\n}",
      "error": null
     }
    ]
   },
   "error": null,
   "activity": [
    {
     "type": "api",
     "query": "tinyfish docs",
     "status": 200
    }
   ]
  }
 },
 {
  "name": "tinyfish fetch with a purpose and a timeout",
  "kind": "extract",
  "fn": "extractWithTinyFish",
  "env": {
   "TINYFISH_API_KEY": "wire-tinyfish-key"
  },
  "args": [
   "https://example.com/good",
   {
    "prompt": "  Read the article  ",
    "timeoutMs": 45000
   }
  ],
  "responses": [
   {
    "status": 200,
    "body": {
     "results": [
      {
       "url": "https://example.com/good",
       "final_url": "https://example.com/good",
       "title": " Good ",
       "text": "  # Rendered body  "
      }
     ],
     "errors": []
    }
   }
  ],
  "expect": {
   "calls": [
    {
     "method": "POST",
     "url": "https://api.fetch.tinyfish.ai",
     "headers": {
      "content-type": "application/json",
      "x-api-key": "wire-tinyfish-key"
     },
     "body": {
      "urls": [
       "https://example.com/good"
      ],
      "format": "markdown",
      "per_url_timeout_ms": 45000,
      "purpose": "Read the article"
     }
    }
   ],
   "result": {
    "url": "https://example.com/good",
    "title": "Good",
    "content": "# Rendered body",
    "error": null
   },
   "error": null,
   "activity": [
    {
     "type": "fetch",
     "url": "https://example.com/good",
     "status": 200
    }
   ]
  }
 },
 {
