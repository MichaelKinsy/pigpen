 {
  "name": "searchinfinity search with filters and a business error",
  "kind": "search",
  "fn": "searchWithSearchinfinity",
  "env": {
   "SEARCHINFINITY_API_KEY": "wire-searchinfinity-key"
  },
  "args": [
   "searchinfinity docs",
   {
    "numResults": 2,
    "recencyFilter": "year",
    "domainFilter": [
     "https://www.byteplus.com/docs",
     "a.example.com",
     "-example.com",
     "-b.example.com"
    ]
   }
  ],
  "responses": [
   {
    "status": 200,
    "body": {
     "ResponseMetadata": {
      "RequestId": "r"
     },
     "Result": {
      "WebResults": [
       {
        "Title": "Docs",
        "Url": "https://www.byteplus.com/docs",
        "Snippet": " short ",
        "Summary": " Model   summary "
       },
       {
        "Url": "https://x.example/y",
        "Snippet": "only snippet"
       }
      ]
     }
    }
   }
  ],
  "expect": {
   "calls": [
    {
     "method": "POST",
     "url": "https://torchlight.byteintlapi.com/search_api/web_search",
     "headers": {
      "authorization": "Bearer wire-searchinfinity-key",
      "content-type": "application/json"
     },
     "body": {
      "Query": "searchinfinity docs",
      "Count": 2,
      "Filter": {
       "Sites": "www.byteplus.com|a.example.com",
       "BlockHosts": "example.com|b.example.com"
      },
      "TimeRange": "OneYear"
     }
    }
   ],
   "result": {
    "answer": "Model summary\nSource: Docs (https://www.byteplus.com/docs)\n\nonly snippet\nSource: https://x.example/y (https://x.example/y)",
    "results": [
     {
      "title": "Docs",
      "url": "https://www.byteplus.com/docs",
      "snippet": "Model summary"
     },
     {
      "title": "https://x.example/y",
      "url": "https://x.example/y",
      "snippet": "only snippet"
     }
    ]
   },
   "error": null,
   "activity": [
    {
     "type": "api",
     "query": "searchinfinity docs",
     "status": 200
    }
   ]
  }
 },
 {
