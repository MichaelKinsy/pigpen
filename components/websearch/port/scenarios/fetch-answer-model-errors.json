{
 "name": "fetch-answer-model-errors",
 "description": "fetch_content mode answer reports an unusable model, an unknown model and a missing prompt without calling a model.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\", \"ssrf\": {\"allowRanges\": [\"127.0.0.0/8\"]}}"
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "fetch_content",
     "arguments": {
      "url": "{{server:web}}/page",
      "mode": "answer",
      "prompt": "Q?",
      "answerModel": "no-slash"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "fetch_content",
     "arguments": {
      "url": "{{server:web}}/page",
      "mode": "answer",
      "prompt": "Q?",
      "answerModel": "nowhere/missing-model"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "fetch_content",
     "arguments": {
      "url": "{{server:web}}/page",
      "mode": "answer"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "servers": {
  "web": {
   "routes": [
    {
     "path": "/page",
     "headers": {
      "content-type": "text/plain"
     },
     "body": "Plain page served by the fake web server.\n"
    },
    {
     "path": "/gone",
     "status": 404,
     "headers": {
      "content-type": "text/html"
     },
     "body": "<html>exact raw body</html>"
    }
   ]
  }
 },
 "normalize": [
  {
   "pattern": "(responseId[\\\": ]+)[0-9a-z]{9,14}\\b",
   "replacement": "${1}<response-id>"
  },
  {
   "pattern": "^[m-o][0-9a-z]{8,13}$",
   "replacement": "<response-id>"
  }
 ]
}
