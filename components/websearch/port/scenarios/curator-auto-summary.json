{
 "name": "curator-auto-summary",
 "description": "web_search with workflow auto-summary: no curator and no browser; the summary is generated through the host's model registry (no summary model is available in the harness, so the deterministic fallback summarizes), and the result carries the summary details.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\", \"ssrf\": {\"allowRanges\": [\"127.0.0.0/8\"]}, \"provider\": \"tavily\", \"tavilyApiKey\": \"tvly-test-key\", \"tavilyBaseUrl\": \"{{server:tavily}}\", \"curatorTimeoutSeconds\": 1}"
 },
 "commands": {
  "xdg-open": {
   "mode": "canned",
   "exit": 0
  },
  "open": {
   "mode": "canned",
   "exit": 0
  },
  "cmd": {
   "mode": "canned",
   "exit": 0
  },
  "npm": {
   "mode": "missing"
  }
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "hello world",
      "workflow": "auto-summary"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "servers": {
  "tavily": {
   "recordHeaders": [
    "authorization"
   ],
   "routes": [
    {
     "method": "POST",
     "path": "/search",
     "json": {
      "answer": "Tavily says hello.",
      "results": [
       {
        "title": "Source one",
        "url": "https://example.com/one",
        "content": "First source."
       },
       {
        "title": "Source two",
        "url": "https://example.com/two",
        "content": "Second source."
       }
      ]
     }
    }
   ]
  }
 },
 "normalize": [
  {
   "pattern": "(responseId[\\\": ]+)[0-9a-z]{9,14}\\b",
   "replacement": "${1}<response-id>"
  },
  {
   "pattern": "^[m-o][0-9a-z]{8,13}$",
   "replacement": "<response-id>"
  },
  {
   "pattern": "http://localhost:[0-9]+/",
   "replacement": "http://localhost:<port>/"
  }
 ]
}
