{
 "name": "web-search-baizhi-bad-filter",
 "description": "Baizhi validates its domain filter before any network request.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\", \"baizhiApiKey\": \"synthetic-baizhi-key\"}"
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "q",
      "provider": "baizhi",
      "domainFilter": [
       "invalid"
      ],
      "workflow": "none"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "normalize": [
  {
   "pattern": "(responseId[\\\": ]+)[0-9a-z]{9,14}\\b",
   "replacement": "${1}<response-id>"
  },
  {
   "pattern": "^[m-o][0-9a-z]{8,13}$",
   "replacement": "<response-id>"
  }
 ]
}
