{
 "name": "web-search-hosted-missing-credentials",
 "description": "web_search with each fixed-endpoint hosted provider selected and no credential: the provider's own key guidance, before any network request.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\"}"
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key tinyfish",
      "provider": "tinyfish",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key search1api",
      "provider": "search1api",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key searchinfinity",
      "provider": "searchinfinity",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key querit",
      "provider": "querit",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key parallel",
      "provider": "parallel",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key ollama",
      "provider": "ollama",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "no key brightdata",
      "provider": "brightdata",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "servers": {},
 "normalize": [
  {
   "pattern": "\\b[0-9a-z]{14}\\b",
   "replacement": "<response-id>"
  }
 ]
}
