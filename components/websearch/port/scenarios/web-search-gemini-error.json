{
 "name": "web-search-gemini-error",
 "description": "web_search through a fake Gemini API (geminiBaseUrl): the request carries the key header and the generateContent body with the google_search tool; a 503 comes back as the explicit-provider failure.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\", \"provider\": \"gemini\", \"geminiApiKey\": \"synthetic-gemini-key\", \"geminiBaseUrl\": \"{{server:gemini}}\"}"
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "latest typescript release",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "servers": {
  "gemini": {
   "recordHeaders": [
    "x-goog-api-key",
    "cf-aig-authorization",
    "authorization"
   ],
   "routes": [
    {
     "method": "POST",
     "path": "/v1beta/models/gemini-3.6-flash:generateContent",
     "status": 503,
     "body": "model overloaded"
    }
   ]
  }
 },
 "normalize": [
  {
   "pattern": "(responseId[\\\": ]+)[0-9a-z]{9,14}\\b",
   "replacement": "${1}<response-id>"
  },
  {
   "pattern": "^[m-o][0-9a-z]{8,13}$",
   "replacement": "<response-id>"
  }
 ]
}
