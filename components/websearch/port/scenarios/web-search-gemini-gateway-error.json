{
 "name": "web-search-gemini-gateway-error",
 "description": "A Cloudflare AI Gateway base URL (the host contains gateway.ai.cloudflare.com) switches the auth to the cf-aig-authorization header and sends no Gemini key; a 429 comes back as the explicit-provider failure.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\", \"provider\": \"gemini\", \"geminiApiKey\": \"synthetic-gemini-key\", \"cloudflareApiKey\": \"synthetic-cloudflare-key\", \"geminiBaseUrl\": \"{{server:gemini}}/gateway.ai.cloudflare.com/v1/account/gateway/google-ai-studio\"}"
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "gateway query",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "servers": {
  "gemini": {
   "recordHeaders": [
    "x-goog-api-key",
    "cf-aig-authorization",
    "authorization"
   ],
   "routes": [
    {
     "method": "POST",
     "path": "/gateway.ai.cloudflare.com/v1/account/gateway/google-ai-studio/v1beta/models/gemini-3.6-flash:generateContent",
     "status": 429,
     "body": "gateway rate limited"
    }
   ]
  }
 },
 "normalize": [
  {
   "pattern": "(responseId[\\\": ]+)[0-9a-z]{9,14}\\b",
   "replacement": "${1}<response-id>"
  },
  {
   "pattern": "^[m-o][0-9a-z]{8,13}$",
   "replacement": "<response-id>"
  }
 ]
}
