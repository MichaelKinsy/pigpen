{
 "name": "web-search-gemini-credential-failure",
 "description": "A Gemini key source that cannot be resolved ($NAME names an unset variable) fails closed with the fixed credential message and sends no request.",
 "agentFiles": {
  "web-search.json": "{\"toolActivation\": \"eager\", \"provider\": \"gemini\", \"geminiApiKey\": \"$GEMINI_KEY_THAT_IS_NOT_SET\", \"geminiBaseUrl\": \"{{server:gemini}}\"}"
 },
 "llm": [
  {
   "toolCalls": [
    {
     "name": "web_search",
     "arguments": {
      "query": "must fail closed",
      "workflow": "none"
     }
    }
   ]
  },
  {
   "text": "done"
  }
 ],
 "steps": [
  {
   "name": "ask",
   "rpc": {
    "type": "prompt",
    "message": "research this"
   }
  }
 ],
 "servers": {
  "gemini": {
   "routes": [
    {
     "path": "/v1beta/*",
     "status": 500,
     "body": "must not be reached"
    }
   ]
  }
 },
 "normalize": [
  {
   "pattern": "(responseId[\\\": ]+)[0-9a-z]{9,14}\\b",
   "replacement": "${1}<response-id>"
  },
  {
   "pattern": "^[m-o][0-9a-z]{8,13}$",
   "replacement": "<response-id>"
  }
 ]
}
