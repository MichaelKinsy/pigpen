{
  "name": "metadata-json-order",
  "description": "Metadata is printed and merged as JSON.stringify does: array-index keys first in numeric order, nested objects too, numbers as JavaScript writes them.",
  "llm": [
    {
      "toolCalls": [
        {
          "name": "TaskCreate",
          "arguments": {
            "subject": "Meta",
            "description": "d",
            "metadata": {
              "zeta": 1,
              "10": "ten",
              "2": "two",
              "alpha": {
                "y": 1,
                "3": 3,
                "1": 1
              },
              "big": 1e+21,
              "small": 1e-07,
              "frac": 1.5
            }
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "TaskGet",
          "arguments": {
            "taskId": "1"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "TaskUpdate",
          "arguments": {
            "taskId": "1",
            "metadata": {
              "7": "seven",
              "zeta": null,
              "20": [
                1,
                2
              ]
            }
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "TaskGet",
          "arguments": {
            "taskId": "1"
          }
        }
      ]
    },
    {
      "text": "done"
    }
  ],
  "steps": [
    {
      "name": "prompt",
      "rpc": {
        "type": "prompt",
        "message": "work on it"
      }
    }
  ]
}
